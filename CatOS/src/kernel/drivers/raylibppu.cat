; ==========================
;   CatOS Raylib PPU driver (display + keyboard)
; ==========================
; A backend for the device-agnostic console (console.cat) and display service
; (gfx/display.cat). It drives the CatMachine Raylib PPU as the text display, the
; linear framebuffer, the keyboard and the pointer.
;
; Nothing above this file names this driver. It publishes itself three ways and is
; reached only through those:
;
;   * display_register(rppu_gfx_ops) - the display device vtable: mode switching,
;     present, screen size, and the console vtable for its text mode;
;   * console_input_char - keyboard characters into the line discipline, via
;     input_offer_key first so the screen's owner gets the keys it grabbed;
;   * pointer_move / pointer_button - pointer state into the display service.
;
; So a serial terminal, a plain framebuffer or a different PPU can replace any one
; of those roles without the console, the surface service or the window manager
; changing at all.
;
;
; -- Display: the tiled PPU mode ---------------------------------------------
;
; The PPU's Tiled512X384 mode (0x11) is a 16x16, 4bpp, palette-indexed tile
; engine with a 34-wide tile map (32x24 visible cells). We use it as a text
; mode: the font is uploaded once into the tile set (glyph N -> tile N), and
; drawing a character is just writing its code into a tile-map cell. The whole
; framebuffer is one 34,868-byte region in guest RAM whose layout is:
;
;   +0      clear colour (BGRX word)
;   +4      palette: 8 palettes x 16 colours x 4 bytes (BGRA)
;   +516    tile set: 256 tiles x 128 bytes (16x16 @ 4bpp, 2px/byte, hi nibble
;           = left pixel; nibble value = palette colour index)
;   +33284  scroll (x,y bytes)
;   +33286  tile map: 34 cols x 26 rows, 1 byte = tile number
;   +34170  per-cell palette (packed, we leave it 0 = palette 0)
;   +34612  sprites (we leave them disabled)
;
; We build glyphs with colour index 1 (foreground) on 0 (background); palette 0
; is set to white-on-black.
;
;
; -- Input: the keyboard ------------------------------------------------------
;
; The keyboard device raises interrupt 0x70 and exposes (eventType, keycode) pairs
; read with `in`, where the type is 1 for a press and 0 for a release. The ISR
; drains them, turns each into the key event word display.cat describes, offers it
; to input_offer_key first, and otherwise feeds the character it carries to the
; console line discipline.
;
; The offer has to happen here, in the ISR, because the line discipline is
; downstream and would swallow anything the screen's owner wanted. What it does NOT
; do is decide which keys are special - it just asks. The keycodes in the grab table
; are ones a window manager passed down, and they are Raylib keycodes only because
; this is the driver that produced them.
;
;
; -- Modifiers, and why they live in the driver -------------------------------
;
; A keycode on its own is not a character: SHIFT+2 is '@' on this keyboard and
; something else on another one, and only a keyboard driver can say which. So this
; file is the one place that holds two related pieces of knowledge - which keycodes
; are the modifier keys, and what character each key produces with them held - and
; it publishes the answer in every event it builds, rather than leaving each program
; to carry a copy of the layout.
;
; Tracking held modifiers needs releases, which is why the ISR now handles both
; directions rather than only presses. Presses and releases are counted per physical
; key in rppu_modkeys (the machine has two of each modifier and letting go of one
; while the other is held must not clear it) and folded to the four KMOD_* bits only
; when an event is built.
;
; What this file does *not* do is decide the shape of a key event. It reports four
; facts to input_key_pack - keycode, character, modifiers held, press or release -
; and the kernel assembles the word. So nothing here mentions where a field lives,
; and a keyboard on entirely different hardware reimplements only this section.
;
; An ALT chord deliberately produces no character at all: it is a command, and this
; driver has no idea which - so the raw keycode and the modifier bits go to whoever
; grabbed the key and the line discipline is told nothing, rather than being handed
; a stray 'c'.
;
; A CTRL chord is different, and only because the US layout says so: CTRL and a
; letter is that letter's ASCII control code, which is a fact about this keyboard in
; exactly the way SHIFT+2 being '@' is. So the layout answers it here, once, and
; Ctrl+C arrives at a line discipline as the character 3 - which is what lets the
; console and a pty implement the interrupt key without either of them naming a
; keycode or a modifier bit. Everything else a control chord makes is still a
; control code, so a program being typed into drops it as unprintable exactly as it
; drops a stray 0.

#define GFX_TYPE, 0xFF64BEF9     ; PPU graphics device type
#define KBD_TYPE, 0x2EB3AD76     ; PPU keyboard device type
#define MOUSE_TYPE, 0x25A3E57D   ; PPU mouse device type
#define INT_KBD, 0x70            ; keyboard input interrupt
#define INT_MOUSE, 0x73          ; mouse input interrupt (0x70 kbd, 0x71 timer, 0x72 disk)


#define GFX_CMD_UPDATE, 1        ; UpdateDisplay command
#define GFX_CMD_SETMODE, 2       ; ChangeDisplayMode command
#define RPPU_MODE, 0x11          ; Tiled512X384 (the text console mode)
#define RPPU_MODE_LINEAR, 0x01   ; Raw512X384: a flat 512x384 BGRX framebuffer
#define RPPU_LIN_W, 512          ; linear framebuffer width
#define RPPU_LIN_H, 384          ; linear framebuffer height

#define FB_PALETTE, 4
#define FB_TILESET, 516
#define FB_TILEMAP, 33286
#define FB_MAPBYTES, 884         ; 34 * 26
#define FB_PAGES, 69             ; ceil(34868 / 512)

; Raylib keycodes this driver has to recognise by name. The modifier keys run
; left-hand set then right-hand set, in the same order as the KMOD_* bits, which is
; what lets rppu_kbd_event turn a keycode into a bit with one shift.
#define RKEY_ENTER, 257
#define RKEY_TAB, 258
#define RKEY_BACKSPACE, 259
#define RKEY_KPENTER, 335
#define RKEY_MOD_FIRST, 340      ; left shift, control, alt, super ...
#define RKEY_MOD_LAST, 347       ; ... then right shift, control, alt, super
#define RKEY_MOD_SIDE, 4         ; modifier bits per side, for folding the two sets

#define MAP_STRIDE, 34           ; tile-map row stride
#define TILE_COLS, 32            ; visible columns
#define TILE_ROWS, 24            ; visible rows
#define TILE_BYTES, 128          ; bytes per 16x16 4bpp tile
#define TILE_ROW_BYTES, 8        ; bytes per tile row (16px @ 4bpp)
#define GLYPH_BYTES, 16          ; bytes per glyph in font.bin (8x16 @ 1bpp)
#define FONT_GLYPHS, 129         ; glyphs the converted font provides


; ---- state ----
rppu_gfxport:
    d32 0
rppu_kbdport:
    d32 0
rppu_mouseport:
    d32 0
rppu_fb:
    d32 0                        ; framebuffer base (guest physical address)
rppu_modkeys:
    d32 0                        ; one bit per physical modifier key currently held,
                                 ; in RKEY_MOD_FIRST..RKEY_MOD_LAST order



; ==========================
;   Display backend
; ==========================

; Bind the graphics device: allocate the framebuffer, upload the font, set the
; tiled display mode, and register as the console's display.
; r1 = port, r2 = unit index
rppu_gfx_bind:
    push r4                      ; framebuffer
    push r5                      ; scratch
    mov [rppu_gfxport], r1

    mov r1, FB_PAGES
    call allocpages
    cmp r0, 0
    je .done
    mov r4, r0
    mov [rppu_fb], r4

    mov r1, r4                   ; zero the whole framebuffer
    mov r2, FB_PAGES * PAGE_SIZE
    call proc_memzero

    ; palette 0: colour 0 = black background (BGRA 00 00 00 FF), colour 1 =
    ; white foreground (FF FF FF FF)
    mov r5, r4
    add r5, FB_PALETTE
    mov [r5], 0xFF000000
    add r5, 4
    mov [r5], 0xFFFFFFFF

    call rppu_load_font          ; glyph N -> tile N
    call rppu_clear              ; fill the tile map with spaces

    mov r1, [rppu_gfxport]       ; enable the tiled display mode
    mov r2, RPPU_MODE
    mov r3, r4
    call rppu_setmode

    mov r1, rppu_gfx_ops         ; publish ourselves as the display device; that
    call display_register        ; also hands our text mode to the console
    .done:
    pop r5
    pop r4
    ret


; ChangeDisplayMode(port, mode, bufferAddr). Returns the device status in r0
; (0 = ok).
; r1 = port, r2 = mode, r3 = buffer address
rppu_setmode:
    out r1, GFX_CMD_SETMODE
    out r1, r2
    out r1, r3
    in r0, r1
    ret


; DISP_PRESENT: flush the framebuffer to the window (blocks until rendered).
rppu_present:
    mov r1, [rppu_gfxport]
    out r1, GFX_CMD_UPDATE
    ret


; Switch the PPU to the linear (Raw512X384) framebuffer at r1 and show it. Used
; by the graphical desktop: the compositor's pixels are copied into this buffer
; and presented. r1 = framebuffer physical address. Returns device status in r0.
rppu_set_linear:
    mov r3, r1
    mov r1, [rppu_gfxport]
    mov r2, RPPU_MODE_LINEAR
    call rppu_setmode
    mov r1, [rppu_gfxport]
    out r1, GFX_CMD_UPDATE
    ret


; Switch the PPU back to the tiled text console and repaint it. The console's
; tile framebuffer (rppu_fb) was never freed, so its contents are still valid.
rppu_set_tiled:
    mov r1, [rppu_gfxport]
    mov r2, RPPU_MODE
    mov r3, [rppu_fb]
    call rppu_setmode
    mov r1, [rppu_gfxport]
    out r1, GFX_CMD_UPDATE
    ret


; DISP_CLEAR: fill the whole tile map with spaces (blank glyph).
rppu_clear:
    push r4
    mov r0, [rppu_fb]
    add r0, FB_TILEMAP
    mov r4, FB_MAPBYTES
    .loop:
        mov8 [r0], 32
        add r0, 1
        sub r4, 1
        cmp r4, 0
        jne .loop
    pop r4
    ret


; DISP_PUTC: place a glyph in a cell -> write its code into the tile map.
; r1 = col, r2 = row, r3 = char
rppu_putc:
    mov r0, r2
    umul r0, MAP_STRIDE          ; row * 34
    add r0, r1                   ; + col
    mov r2, [rppu_fb]
    add r0, r2
    add r0, FB_TILEMAP
    mov8 [r0], r3
    ret


; DISP_SCROLL: shift every visible row up one, blank the last row.
rppu_scroll:
    push r4                      ; row
    push r5                      ; tile-map base
    mov r5, [rppu_fb]
    add r5, FB_TILEMAP
    mov r4, 0
    .rowloop:
        cmp r4, TILE_ROWS - 1
        juge .clearlast
        mov r0, r4               ; dest = base + row*34
        umul r0, MAP_STRIDE
        add r0, r5
        mov r1, r4               ; src = base + (row+1)*34
        add r1, 1
        umul r1, MAP_STRIDE
        add r1, r5
        cpy r1, MAP_STRIDE
        add r4, 1
        jmp .rowloop
    .clearlast:
    mov r0, TILE_ROWS - 1        ; blank the now-duplicated last row
    umul r0, MAP_STRIDE
    add r0, r5
    mov r4, MAP_STRIDE
    .clrloop:
        mov8 [r0], 32
        add r0, 1
        sub r4, 1
        cmp r4, 0
        jne .clrloop
    pop r5
    pop r4
    ret


; Expand one 8-bit font row (1bpp, MSB = left) into 8 tile bytes (4bpp, 2px per
; byte; nibble 1 = foreground, 0 = background). Each source pixel is doubled
; horizontally so the 8px-wide glyph fills the whole 16px tile cell - otherwise
; only the left half is used and every character has an 8px dead gap after it.
; r1 = font byte, r2 = destination address (writes [r2 .. r2+7])
rppu_expand_byte:
    push r4                      ; byte value
    push r5                      ; destination
    push r6                      ; source pixel index 0..7
    push r7                      ; assembled byte
    mov r4, r1
    mov r5, r2
    mov r6, 0
    .loop:
        cmp r6, 8
        juge .done
        mov r1, 7                ; source pixel bit = 7 - r6 (MSB = left)
        sub r1, r6
        mov r7, r4
        shr r7, r1
        and r7, 1                ; r7 = this pixel (0 or 1)
        mov r0, r7               ; duplicate it into both nibbles: 0x00 or 0x11,
        shl r0, 4                ; so the pixel spans two output pixels (2x wide)
        or r7, r0
        mov r0, r5
        add r0, r6
        mov8 [r0], r7
        add r6, 1
        jmp .loop
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Upload the whole font into the tile set: glyph N becomes tile N, scaled 2x
; horizontally so it fills the full 16x16 cell (no dead space between glyphs).
rppu_load_font:
    push r4                      ; glyph index
    push r5                      ; row index
    push r6                      ; source font byte address
    push r7                      ; tile row destination
    mov r4, 0
    .glyph:
        cmp r4, FONT_GLYPHS
        juge .done
        mov r5, 0
        .row:
            cmp r5, GLYPH_BYTES
            juge .nextglyph
            mov r6, r4           ; font byte at rppu_font + g*16 + row
            umul r6, GLYPH_BYTES
            add r6, r5
            add r6, rppu_font
            mov8 r6, [r6]

            mov r7, r4           ; tile row at fb + FB_TILESET + g*128 + row*8
            umul r7, TILE_BYTES
            mov r0, r5
            umul r0, TILE_ROW_BYTES
            add r7, r0
            mov r0, [rppu_fb]
            add r7, r0
            add r7, FB_TILESET

            mov r1, r6           ; expand the 8 glyph bits into 8 tile bytes
            mov r2, r7
            call rppu_expand_byte

            add r5, 1
            jmp .row
        .nextglyph:
        add r4, 1
        jmp .glyph
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


rppu_disp_ops:                   ; the console's display vtable (see console.cat)
    d32 rppu_putc                ; DISP_PUTC
    d32 rppu_scroll              ; DISP_SCROLL
    d32 rppu_clear               ; DISP_CLEAR
    d32 rppu_present             ; DISP_PRESENT


rppu_gfx_ops:                    ; the display device record (see gfx/display.cat)
    d32 rppu_set_linear          ; GDEV_LINEAR
    d32 rppu_set_tiled           ; GDEV_TEXT
    d32 rppu_present             ; GDEV_PRESENT
    d32 rppu_disp_ops            ; GDEV_TEXTOPS
    d32 TILE_COLS                ; GDEV_TCOLS
    d32 TILE_ROWS                ; GDEV_TROWS
    d32 RPPU_LIN_W               ; GDEV_W
    d32 RPPU_LIN_H               ; GDEV_H


; ==========================
;   Keyboard backend
; ==========================

; Bind the keyboard device: route its interrupt to our ISR.
; r1 = port, r2 = unit index
rppu_kbd_bind:
    mov [rppu_kbdport], r1
    mov r1, INT_KBD
    mov r2, rppu_kbd_isr
    call intregister
    ret


; The character each key produces with SHIFT held, indexed by the key's unshifted
; character minus 32 - which is what a Raylib printable keycode already is. This
; table IS the keyboard layout (a US one), and it is the only place in the machine
; that knows '/' and SHIFT make '?'.
; Several entries are unreachable - Raylib only ever reports the code of a character
; some key produces *unshifted*, so nothing arrives as '!' or '@' - and exist only to
; keep the table dense enough to index with one subtraction. The two entries spelt
; numerically are quote marks, which the assembler will not take in a string literal.
rppu_shift_map:
    dstr " !"                    ;  32..33
    d8 34, 35, 36, 37, 38        ;  34..38
    d8 34                        ;  39      apostrophe -> quote
    dstr "()*+"                  ;  40..43
    dstr "<_>?"                  ;  44..47   comma -> <   - -> _   . -> >   / -> ?
    dstr ")!@#$%^&*("            ;  48..57   the digit row
    dstr "::<+>?@"               ;  58..64   semicolon -> colon   = -> +
    dstr "ABCDEFGHIJKLMNOPQRSTUVWXYZ"   ;  65..90   letters: shifted is upper case
    dstr "{|}^_~"                ;  91..96   [ -> {   backslash -> |   ] -> }   ` -> ~


; The character a keycode produces with these modifiers held, or 0 for a key that
; types nothing (the arrows, the function keys, the modifiers themselves, and any
; chord this driver refuses to call text).
; r1 = keycode, r2 = KMOD_* mask -> r0 = ascii (0 = types nothing)
rppu_keymap:
    push r4                      ; keycode
    push r5                      ; modifiers
    mov r4, r1
    mov r5, r2
    mov r0, r5                   ; an alt chord is a command, not text: report no
    and r0, KMOD_ALT             ; character and leave what it means to whoever
    cmp r0, 0                    ; grabbed the key
    jne .none
    mov r0, r5
    and r0, KMOD_CTRL
    cmp r0, 0
    jne .ctrl
    cmp r4, 32                   ; Raylib's printable codes are the unshifted
    jul .control                 ; characters of the US layout, upper case for
    cmp r4, 96                   ; letters, so they span ' ' .. '`'
    jug .control
    mov r0, r5
    and r0, KMOD_SHIFT
    cmp r0, 0
    jne .shifted
    cmp r4, 65                   ; 'A': unshifted letters are lower case
    jul .plain
    cmp r4, 90
    jug .plain
    mov r0, r4
    add r0, 32
    jmp .ret
    .plain:
    mov r0, r4
    jmp .ret
    .shifted:
    mov r0, r4                   ; what the layout says this key makes with SHIFT
    sub r0, 32
    add r0, rppu_shift_map
    mov8 r0, [r0]
    jmp .ret
    .ctrl:                       ; CTRL + a letter is that letter's control code -
    cmp r4, 65                   ; 'A' -> 1 .. 'Z' -> 26, the US layout's answer, and
    jul .none                    ; the only reason a line discipline can recognise
    cmp r4, 90                   ; the interrupt key without knowing any keycode.
    jug .none                    ; CTRL with anything else still types nothing.
    mov r0, r4
    sub r0, 64
    jmp .ret
    .control:
    cmp r4, RKEY_ENTER
    je .enter
    cmp r4, RKEY_KPENTER
    je .enter
    cmp r4, RKEY_BACKSPACE
    je .backspace
    cmp r4, RKEY_TAB
    je .tab
    .none:
    mov r0, 0
    jmp .ret
    .enter:
    mov r0, 10
    jmp .ret
    .backspace:
    mov r0, 8
    jmp .ret
    .tab:
    mov r0, 9
    .ret:
    pop r5
    pop r4
    ret


; Fold one key event into the modifier state and describe it the way
; input_key_pack wants it: the KMOD_* bits now held, plus KEYF_RELEASE and
; KEYF_MODKEY where they apply. A modifier key updates the held set *before* the
; state is read back, so its own event reports what it just brought about - pressing
; SHIFT arrives with KMOD_SHIFT already set, which is what a program watching raw key
; state expects.
; r1 = keycode, r2 = 1 for a press / 0 for a release -> r0 = KMOD_* | KEYF_*
rppu_key_state:
    push r4                      ; keycode
    push r5                      ; press / release
    push r6                      ; the flags being assembled
    mov r4, r1
    mov r5, r2
    mov r6, 0
    cmp r5, 0
    jne .ismod
    mov r6, KEYF_RELEASE
    .ismod:
    cmp r4, RKEY_MOD_FIRST       ; is this one of the modifier keys itself?
    jul .fold
    cmp r4, RKEY_MOD_LAST
    jug .fold
    or r6, KEYF_MODKEY           ; so nothing above has to know these keycodes
    mov r0, r4                   ; its bit in the held set - the Raylib codes run
    sub r0, RKEY_MOD_FIRST       ; left-hand set then right-hand set, in KMOD_* order
    mov r1, 1
    shl r1, r0
    mov r0, [rppu_modkeys]
    cmp r5, 0
    je .release
    or r0, r1
    jmp .storekeys
    .release:
    not r1
    and r0, r1
    .storekeys:
    mov [rppu_modkeys], r0
    .fold:
    mov r0, [rppu_modkeys]       ; either of a pair counts as that modifier held, so
    mov r1, r0                   ; letting go of one shift with the other still down
    shr r1, RKEY_MOD_SIDE        ; leaves KMOD_SHIFT set
    or r0, r1
    and r0, KMOD_ALL
    or r0, r6
    pop r6
    pop r5
    pop r4
    ret


; Interrupt 0x70 handler: drain (type, keycode) pairs and turn each into a key
; event. Preempts kernel code, so it saves/restores everything.
;
; Releases are handled as well as presses, because the modifier state depends on
; them and because a program reading raw keys - a game - needs them. They go only to
; whoever grabbed the key: the line discipline deals in characters, and a release is
; not one.
rppu_kbd_isr:
    int_prologue
    mov r4, [rppu_kbdport]
    .drain:
        in r0, r4                ; event type (0xFFFFFFFF = queue empty)
        cmp r0, -1
        je .done
        mov r5, r0
        in r6, r4                ; keycode (consume it either way)
        cmp r5, 1
        je .event
        cmp r5, 0
        jne .drain               ; an event type this driver does not know
        .event:
        mov r1, r6               ; what is held, and which way this key went
        mov r2, r5
        call rppu_key_state
        mov r7, r0
        mov r1, r6               ; what our layout makes of the two together
        mov r2, r7
        and r2, KMOD_ALL
        call rppu_keymap
        push r0                  ; the console wants that character in a moment
        mov r2, r0
        mov r1, r6
        mov r3, r7
        call input_key_pack      ; the kernel owns the event layout, not us
        mov r1, r0
        call input_offer_key     ; a key the screen's owner grabbed goes to it and
        pop r2                   ; never reaches the console
        cmp r0, 0
        jne .drain
        cmp r5, 0
        je .drain                ; a release is not a character
        cmp r2, 0
        je .drain                ; nor is a key that types nothing
        mov r1, r2
        call console_input_char
        jmp .drain
    .done:
    int_epilogue


; ---- mouse -----------------------------------------------------------------
; Bind the PPU mouse: give it a distinct interrupt code (the keyboard already
; owns 0x70) and install the ISR. r1 = port, r2 = unit index.
rppu_mouse_bind:
    mov [rppu_mouseport], r1
    out r1, INT_MOUSE            ; tell the device which interrupt to raise
    mov r1, INT_MOUSE
    mov r2, rppu_mouse_isr
    call intregister
    ret


; Interrupt 0x73 handler: drain (type, value) pairs and publish them through the
; display service's pointer interface, which is where anything that cares reads
; from. type 2 = move (value = x | y<<16), type 1 = button down, type 0 = button
; up (value = raylib button index).
rppu_mouse_isr:
    int_prologue
    mov r4, [rppu_mouseport]
    .drain:
        in r0, r4                ; event type (0xFFFFFFFF = queue empty)
        cmp r0, -1
        je .done
        mov r5, r0
        in r6, r4                ; value
        cmp r5, 2
        je .move
        cmp r5, 1
        je .btndown
        cmp r5, 0
        je .btnup
        jmp .drain
        .move:
        mov r1, r6
        and r1, 0xFFFF           ; x = low 16 bits
        mov r2, r6
        shr r2, 16               ; y = high 16 bits
        and r2, 0xFFFF
        call pointer_move
        jmp .drain
        .btndown:
        mov r1, r6               ; button index
        mov r2, 1
        call pointer_button
        jmp .drain
        .btnup:
        mov r1, r6
        mov r2, 0
        call pointer_button
        jmp .drain
    .done:
    int_epilogue


; ---- the adapted font (converted from the x86 testos 8x16 font to 1bpp) ----
rppu_font:
    ; the build script generates build/font.bin; this path is relative to this
    ; source file (src/kernel/drivers/) up to the repo's build/ directory
    dfile "../../../build/font.bin"
