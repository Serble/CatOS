; ==========================
;   CatOS process model
; ==========================
; A process is a user-mode program with its own memory segment and its own
; kernel stack. The VM already gives us everything needed to run one safely:
;
;   * virtual mode relocates every user access by MBase and bounds-checks it
;     against MLen, so a process sees a private 0-based address space and can
;     never reach kernel memory or another process;
;   * on a user->kernel trap the CPU switches Sp onto the per-process kernel
;     stack (Ksp) and pushes the entire resumable state as an "interrupt frame";
;     `iret` restores it atomically. A suspended process is therefore fully
;     described by one saved kernel-stack pointer (SAVED_SP) pointing at its
;     frame.
;
; This file owns the process table and the mechanics of *building* a process
; (carving a segment, loading a flat image, and manufacturing the first frame
; so it can be entered with the ordinary resume path). Scheduling and the
; context switch itself live in sched.cat.
;
;
; -- The interrupt frame (must match CatVm.BuildInterruptFrameAndDispatch) ----
;
; A user->kernel frame is pushed low->high address as:
;   marker(1B), ip(4), sp(4), fl(4), mbase(4), mlen(4), r7,r6,r5,r4,r3,r2,r1,r0
; so from the frame base (where SAVED_SP / Sp points on entry) the fields sit at
; the offsets below. Total size 1 + 4*12 = 53 bytes. `iret` pops the marker
; first, then everything else, and restores Mode from the marker.


; ---- process states ----
#define PROC_FREE, 0            ; slot unused
#define PROC_READY, 1           ; runnable, waiting for the CPU
#define PROC_RUNNING, 2         ; currently on the CPU
#define PROC_BLOCKED, 3         ; waiting on a channel (see PCB_CHAN)
#define PROC_ZOMBIE, 4          ; exited, awaiting reap by wait()
#define PROC_EMBRYO, 5          ; being constructed (not yet runnable)

; ---- PCB (process control block) layout ----
#define PCB_STATE, 0            ; one of PROC_*
#define PCB_PID, 4              ; process id
#define PCB_SAVEDSP, 8          ; kernel Sp to resume at (points at the frame)
#define PCB_KSP, 12             ; kernel-stack top (loaded into the Ksp register)
#define PCB_KSTACK, 16          ; kernel-stack base (for freeing)
#define PCB_MBASE, 20           ; user segment physical base
#define PCB_MLEN, 24            ; user segment length (bytes)
#define PCB_USEG, 28            ; user segment base (== MBASE, kept for freeing)
#define PCB_UPAGES, 32          ; user segment page count
#define PCB_KPAGES, 36          ; kernel-stack page count
#define PCB_PARENT, 40          ; parent PCB, 0 if none
#define PCB_EXIT, 44            ; exit code (valid once ZOMBIE)
#define PCB_CHAN, 48            ; blocking channel, 0 if not blocked
#define PCB_PPID, 52            ; parent's pid, taken at creation. PCB_PARENT is a
                                ; pointer and its slot can be recycled under us
                                ; (nothing reparents orphans), so anything that
                                ; *reports* a parent - ps - reads this instead
#define PCB_FDS, 56             ; per-process fd table: MAX_FDS slots, each a
                                ; VFS handle index or -1 for a free slot
; ---- signal state (see signal.cat) ----
#define PCB_SIGH, 88            ; NSIG disposition slots (0 = default, 1 = ignore,
                                ; else a user handler vaddr), 4 bytes each
#define PCB_SIGPEND, 152        ; pending-signal bitmask (bit N = signal N pending)
#define PCB_SIGSAVE, 156        ; saved interrupt frame while a handler runs (for
                                ; sigreturn); FRM_SIZE bytes, padded to 56
#define PCB_SIGINFR, 212        ; nonzero while a signal handler is running
#define PCB_CWD, 216            ; canonical working-directory string, VFS_PATH_MAX
                                ; bytes (always absolute, no trailing slash but "/")
#define PCB_NAME, 472           ; program name, PROC_NAME_MAX bytes stored inline
                                ; and always terminated. It is a *copy* because a
                                ; caller's path buffer is scratch that gets reused;
                                ; a pointer would dangle by the time ps read it
#define PCB_TTY, 488            ; controlling terminal: the device path this
                                ; process's stdin/stdout/stderr were opened from,
                                ; and that its children will open in turn. It is a
                                ; path rather than a handle because a child needs
                                ; its *own* three handles, and inheriting is the
                                ; whole point - a shell started on a pty runs `ls`
                                ; on the same pty without either of them knowing.
                                ; "/dev/console" unless SYS_SETTTY moved it
#define PCB_TTY_MAX, 24         ; enough for "/dev/console" and "/dev/ptyN"
#define PCB_STRUCT, 512         ; total PCB size (PCB_TTY + PCB_TTY_MAX)

; ---- SYS_PSLIST record: pid, parent pid, state, then the inline name ----
#define PSREC_BYTES, 28         ; 3 words + PROC_NAME_MAX (keep in sync with
                                ; user/sys.cat, which declares the same record)

; ---- interrupt-frame field offsets (from the frame base) ----
#define FRM_MARKER, 0           ; 1 byte
#define FRM_IP, 1
#define FRM_SP, 5
#define FRM_FL, 9
#define FRM_MBASE, 13
#define FRM_MLEN, 17
#define FRM_R7, 21
#define FRM_R6, 25
#define FRM_R5, 29
#define FRM_R4, 33
#define FRM_R3, 37
#define FRM_R2, 41
#define FRM_R1, 45
#define FRM_R0, 49
#define FRM_SIZE, 53            ; total frame size
#define FRAME_USER, 1           ; marker value for a user-mode frame

; ---- configuration ----
#define MAX_PROCS, 16           ; process table capacity
#define MAX_FDS, 8              ; open file descriptors per process
#define PROC_NAME_MAX, 16       ; program name a PCB records, terminator included
#define PROC_KSTACK_PAGES, 4    ; kernel stack per process (2 KiB; spawn does
                                ; deep in-kernel work - VFS + CatFS - on it)
#define USER_STACK_BYTES, 4096  ; user stack reserved above the image


; ==========================
;   State
; ==========================
curproc:
    d32 0                       ; running PCB, 0 = kernel boot context
nextpid:
    d32 1                       ; next pid to hand out
idleproc:
    d32 0                       ; the idle PCB (always runnable)
proc_tmp_name:
    d32 0                       ; scratch across proc_create (single-threaded)
proc_tmp_upages:
    d32 0
; scratch across sys_sbrk_h (single-threaded: syscalls run non-preemptively)
sbrk_frame:
    d32 0
sbrk_oldbase:
    d32 0
sbrk_oldpages:
    d32 0
sbrk_oldmlen:
    d32 0
sbrk_newbase:
    d32 0
sbrk_newpages:
    d32 0
proctable:
    res8 MAX_PROCS * PCB_STRUCT


; ==========================
;   Helpers
; ==========================

; Zero a region. r1 = address, r2 = length in bytes (must be a multiple of 4).
proc_memzero:
    push r4
    mov r4, r2
    shr r4, 2                    ; word count
    .loop:
        cmp r4, 0
        je .done
        mov [r1], 0
        add r1, 4
        sub r4, 1
        jmp .loop
    .done:
    pop r4
    ret


; Copy a null-terminated kernel string into a fixed-size field, truncating to fit,
; always terminating, and zero-filling whatever is left - so the field is a valid
; string whatever the caller hands us, and its unused tail never carries the
; previous occupant of a recycled slot out to a program that copies it wholesale.
; A null source gives an empty string. Capacity must be at least 1.
; r1 - source string (kernel address, 0 for none)
; r2 - destination field
; r3 - destination capacity in bytes
proc_copyname:
    push r4                      ; destination cursor
    push r5                      ; bytes left in the field
    mov r4, r2
    mov r5, r3
    cmp r1, 0
    je .pad
    .loop:
        cmp r5, 1
        jule .pad                ; the last byte belongs to the terminator
        mov8 r0, [r1]
        cmp r0, 0
        je .pad
        mov8 [r4], r0
        add r1, 1
        add r4, 1
        sub r5, 1
        jmp .loop
    .pad:
        cmp r5, 0
        je .done
        mov8 [r4], 0
        add r4, 1
        sub r5, 1
        jmp .pad
    .done:
    pop r5
    pop r4
    ret


; Initialise the process system. Zeroes the table (every slot -> PROC_FREE) and
; resets the running pointer and pid counter. Call once during boot.
procinit:
    mov r1, proctable
    mov r2, MAX_PROCS * PCB_STRUCT
    call proc_memzero
    mov r0, 0
    mov [curproc], r0
    mov r0, 1
    mov [nextpid], r0
    ret


; Find a free PCB slot, assign it a pid and mark it EMBRYO (so it is neither
; scheduled nor reused while it is being built).
; returns r0 = PCB pointer, or 0 if the table is full
proc_alloc:
    push r4                      ; cursor
    push r5                      ; index
    mov r4, proctable
    mov r5, 0
    .loop:
        cmp r5, MAX_PROCS
        juge .full
        mov r0, [r4]             ; PCB_STATE
        cmp r0, PROC_FREE
        je .found
        add r4, PCB_STRUCT
        add r5, 1
        jmp .loop
    .found:
    mov r0, [nextpid]
    vstore r4, PCB_PID, r0, r1
    add r0, 1
    mov [nextpid], r0
    mov r0, PROC_EMBRYO
    mov [r4], r0                 ; reserve the slot
    mov r0, r4
    jmp .done
    .full:
    mov r0, 0
    .done:
    pop r5
    pop r4
    ret


; Create a runnable process from a flat binary image already in kernel memory.
; The image is loaded at user virtual address 0 and entered at offset 0.
; r1 - image pointer (kernel address)
; r2 - image length in bytes
; r3 - name string pointer
; returns r0 = PCB pointer (state READY), or 0 on failure
proc_create:
    push r4                      ; pcb
    push r5                      ; image ptr
    push r6                      ; image len
    push r7                      ; segment base / ksp / frame base
    mov r5, r1
    mov r6, r2
    mov [proc_tmp_name], r3

    call proc_alloc
    cmp r0, 0
    je .fail
    mov r4, r0

    ; ---- user segment: image + stack, rounded to whole pages ----
    mov r1, r6
    add r1, USER_STACK_BYTES
    add r1, PAGE_SIZE - 1
    shr r1, PAGE_SHIFT_FAC
    mov [proc_tmp_upages], r1
    call allocpages
    cmp r0, 0
    je .failslot
    mov r7, r0                   ; user segment base

    vstore r4, PCB_MBASE, r7, r1
    vstore r4, PCB_USEG, r7, r1
    mov r1, [proc_tmp_upages]
    vstore r4, PCB_UPAGES, r1, r2
    shl r1, PAGE_SHIFT_FAC       ; segment size in bytes
    vstore r4, PCB_MLEN, r1, r2

    ; zero the whole segment (clears bss + stack)
    mov r1, r7
    mov r2, [proc_tmp_upages]
    shl r2, PAGE_SHIFT_FAC
    call proc_memzero

    ; copy the image to the segment start (cpy dest is r0)
    mov r0, r7
    cpy r5, r6

    ; ---- kernel stack ----
    mov r1, PROC_KSTACK_PAGES
    call allocpages
    cmp r0, 0
    je .failseg
    vstore r4, PCB_KSTACK, r0, r1
    mov r1, PROC_KSTACK_PAGES
    vstore r4, PCB_KPAGES, r1, r2
    mov r1, PROC_KSTACK_PAGES
    shl r1, PAGE_SHIFT_FAC
    add r0, r1                   ; kernel-stack top
    vstore r4, PCB_KSP, r0, r1
    sub r0, FRM_SIZE             ; the frame sits just below the top
    vstore r4, PCB_SAVEDSP, r0, r1
    mov r7, r0                   ; r7 = frame base

    ; ---- manufacture the initial user frame ----
    mov8 [r7], FRAME_USER        ; marker
    mov r0, r7                   ; ip = 0 (entry)
    add r0, FRM_IP
    mov [r0], 0
    mov r0, r7                   ; sp = MLEN (top of the user segment)
    add r0, FRM_SP
    vload r1, r4, PCB_MLEN
    mov [r0], r1
    mov r0, r7                   ; fl = 0
    add r0, FRM_FL
    mov [r0], 0
    mov r0, r7                   ; mbase
    add r0, FRM_MBASE
    vload r1, r4, PCB_MBASE
    mov [r0], r1
    mov r0, r7                   ; mlen
    add r0, FRM_MLEN
    vload r1, r4, PCB_MLEN
    mov [r0], r1
    mov r0, r7                   ; r0..r7 = 0
    add r0, FRM_R7
    mov r2, 8
    .zregs:
        mov [r0], 0
        add r0, 4
        sub r2, 1
        cmp r2, 0
        jne .zregs

    ; ---- finalise the PCB ----
    mov r1, [proc_tmp_name]      ; take our own copy of the name (a recycled slot
    mov r2, r4                   ; still holds the previous occupant's, so this
    add r2, PCB_NAME             ; runs even when there is no name to record)
    mov r3, PROC_NAME_MAX
    call proc_copyname
    mov r1, [curproc]
    vstore r4, PCB_PARENT, r1, r2
    mov r0, 0                    ; the parent's pid, or 0 for the processes the
    cmp r1, 0                    ; kernel itself starts at boot
    je .noparent
    vload r0, r1, PCB_PID
    .noparent:
    vstore r4, PCB_PPID, r0, r1
    mov r1, 0
    vstore r4, PCB_EXIT, r1, r2
    vstore r4, PCB_CHAN, r1, r2

    ; clear the signal state: every disposition defaults to SIG_DFL (0), no signal
    ; pending, not currently in a handler (proc_alloc reuses freed slots verbatim,
    ; so a fresh process must not inherit the previous occupant's handlers).
    mov r1, r4
    add r1, PCB_SIGH
    mov r2, PCB_CWD - PCB_SIGH
    call proc_memzero

    ; start with an empty fd table (every slot free = -1)
    mov r0, r4
    add r0, PCB_FDS
    mov r1, MAX_FDS
    .fdinit:
        mov [r0], -1
        add r0, 4
        sub r1, 1
        cmp r1, 0
        jne .fdinit

    ; Controlling terminal: inherit the parent's, or /dev/console for the first
    ; processes (curproc == 0 at boot). This is what makes a terminal emulator
    ; possible - it points its own stdio at a pty, and every shell and every
    ; program that shell runs lands on the same pty without being told.
    mov r1, [curproc]
    mov r2, r4
    call proc_inherit_tty

    ; wire stdin/stdout/stderr (fd 0/1/2) to that terminal
    mov r1, r4
    call proc_open_tty

    ; working directory: inherit the parent's (the spawning process is curproc),
    ; or default to the root "/" for the very first process (curproc == 0).
    mov r1, [curproc]
    cmp r1, 0
    je .cwdroot
    add r1, PCB_CWD              ; source: parent's cwd
    mov r2, r4
    add r2, PCB_CWD             ; dest: child's cwd
    mov r0, VFS_PATH_MAX
    .cwdcopy:
        cmp r0, 0
        je .cwddone
        mov8 r3, [r1]
        mov8 [r2], r3
        cmp r3, 0
        je .cwddone
        add r1, 1
        add r2, 1
        sub r0, 1
        jmp .cwdcopy
    .cwdroot:
    mov r0, r4
    add r0, PCB_CWD
    mov8 [r0], 47               ; '/'
    add r0, 1
    mov8 [r0], 0
    .cwddone:

    mov r1, PROC_READY
    mov [r4], r1                 ; publish as runnable
    mov r0, r4
    jmp .done

    .failseg:
    vload r1, r4, PCB_USEG
    vload r2, r4, PCB_UPAGES
    call freepages
    .failslot:
    mov r1, PROC_FREE
    mov [r4], r1                 ; release the reserved slot
    .fail:
    mov r0, 0
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Copy a process's controlling terminal into a new one, defaulting to
; /dev/console when there is no parent (the processes the kernel starts itself).
; r1 - parent PCB or 0, r2 - child PCB
proc_inherit_tty:
    push r4                      ; source string
    push r5                      ; destination
    push r6                      ; bytes left
    mov r5, r2
    add r5, PCB_TTY
    cmp r1, 0
    je .default
    mov r4, r1
    add r4, PCB_TTY
    jmp .copy
    .default:
    mov r4, consolepath
    .copy:
    mov r6, PCB_TTY_MAX
    .loop:
        cmp r6, 0
        je .term
        mov8 r0, [r4]
        mov8 [r5], r0
        cmp r0, 0
        je .done
        add r4, 1
        add r5, 1
        sub r6, 1
        jmp .loop
    .term:
    sub r5, 1                    ; a path too long to hold is truncated, never
    mov r0, 0                    ; left unterminated
    mov8 [r5], r0
    .done:
    pop r6
    pop r5
    pop r4
    ret


; Open a process's controlling terminal into fd 0, 1 and 2 (stdin/stdout/stderr).
; Each gets its own handle so closing one does not disturb the others - which is
; also what lets a program replace just one of them with the usual close-then-open
; (fd_alloc hands back the lowest free slot).
; r1 - PCB pointer
proc_open_tty:
    push r4                      ; pcb
    push r5                      ; fd index
    mov r4, r1
    mov r5, 0
    .loop:
        cmp r5, 3
        juge .done
        mov r1, r4
        add r1, PCB_TTY
        mov r2, O_RDWR
        call vfsopen
        cmp r0, -1
        je .done                 ; no such terminal: the process starts with no
        push r0                  ; stdio rather than failing to start at all
        mov r1, r4
        mov r2, r5
        mov r3, r0
        call fd_set
        pop r0
        add r5, 1
        jmp .loop
    .done:
    pop r5
    pop r4
    ret


; Release a process's memory and return its slot to the pool. Used by wait()
; to reap a ZOMBIE.
; r1 - PCB pointer
proc_reap:
    push r4
    push r5                      ; fd cursor
    push r6                      ; fd count
    mov r4, r1

    ; close any file descriptors the process left open
    mov r5, r4
    add r5, PCB_FDS
    mov r6, MAX_FDS
    .fdclose:
        mov r0, [r5]
        cmp r0, -1
        je .fdnext
        mov r1, r0
        call vfsclose
        .fdnext:
        add r5, 4
        sub r6, 1
        cmp r6, 0
        jne .fdclose

    vload r1, r4, PCB_USEG
    vload r2, r4, PCB_UPAGES
    cmp r1, 0
    je .noseg
    call freepages
    .noseg:
    vload r1, r4, PCB_KSTACK
    vload r2, r4, PCB_KPAGES
    cmp r1, 0
    je .noks
    call freepages
    .noks:
    mov r0, PROC_FREE
    mov [r4], r0                 ; slot is free again
    pop r6
    pop r5
    pop r4
    ret


; Copy a null-terminated string out of the current process's user address space
; into a kernel buffer. User pointers are virtual (relative to MBase) and cannot
; be dereferenced directly from a handler, so we translate and bounds-check each
; byte against the process's segment.
; r1 - user pointer (virtual)
; r2 - kernel destination buffer
; r3 - destination capacity in bytes
; returns r0 = 0 on success, -1 if the string ran out of bounds or was too long
copyinstr:
    push r4                      ; segment base
    push r5                      ; segment length
    push r6                      ; user offset
    push r7                      ; destination cursor
    mov r0, [curproc]
    vload r4, r0, PCB_MBASE
    vload r5, r0, PCB_MLEN
    mov r6, r1
    mov r7, r2
    .loop:
        cmp r3, 0
        je .fault                ; no room left for even the terminator
        cmp r6, r5
        juge .fault              ; user offset outside the segment
        mov r0, r6
        add r0, r4               ; physical = base + offset
        mov8 r0, [r0]
        mov8 [r7], r0
        cmp r0, 0
        je .ok                   ; copied the terminator
        add r6, 1
        add r7, 1
        sub r3, 1
        jmp .loop
    .ok:
    mov r0, 0
    jmp .done
    .fault:
    mov r0, -1
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Translate a user buffer pointer to a kernel (physical) address, bounds-checking
; the whole [ptr, ptr+len) range against the current process's segment. Because
; the kernel is identity-mapped, the returned address can be handed straight to
; the VFS as a read/write target - no bounce buffer needed.
; r1 - user pointer, r2 - length
; returns r0 = kernel address, or 0 if the range is out of bounds
uaddr:
    push r4                      ; segment length
    mov r0, [curproc]
    vload r4, r0, PCB_MLEN
    mov r0, r1
    add r0, r2                   ; end = ptr + len
    cmp r0, r1
    jul .fault                   ; wrapped -> overflow
    cmp r0, r4
    jug .fault                   ; end past the end of the segment
    mov r0, [curproc]
    vload r0, r0, PCB_MBASE
    add r0, r1                   ; physical = base + ptr
    pop r4
    ret
    .fault:
    mov r0, 0
    pop r4
    ret


; SYS_SBRK (r2 = bytes): grow the current process's memory segment by at least r2
; bytes (rounded up to whole pages). A larger segment is allocated, the old one is
; copied into it and freed, and both the PCB and the live interrupt frame are
; repointed at the new base/length so the caller resumes transparently (user code
; sees a 0-based address space, so moving the physical base is invisible to it).
; Returns r0 = the old segment length - i.e. the base of the freshly added region
; in the caller's address space - or -1 if the growth could not be allocated.
;
; This is how a userland compositor obtains a framebuffer big enough to draw into:
; a full 512*384*4 buffer will not fit inside a program image (CatFS caps files at
; ~68 KiB), so it is mapped in at runtime here instead.
sys_sbrk_h:
    mov r0, sp                       ; capture the caller's frame base (sp = frame)
    mov [sbrk_frame], r0
    mov r4, [curproc]
    vload r0, r4, PCB_MBASE
    mov [sbrk_oldbase], r0
    vload r0, r4, PCB_UPAGES
    mov [sbrk_oldpages], r0
    vload r0, r4, PCB_MLEN
    mov [sbrk_oldmlen], r0
    mov r3, r2                       ; requested bytes -> delta pages
    add r3, PAGE_SIZE - 1
    shr r3, PAGE_SHIFT_FAC
    cmp r3, 0
    je .fail                         ; a zero-page request is meaningless
    mov r0, [sbrk_oldpages]
    add r0, r3                       ; new total page count
    mov [sbrk_newpages], r0
    mov r1, r0
    call allocpages                  ; r0 = new segment base, or 0
    cmp r0, 0
    je .fail
    mov [sbrk_newbase], r0
    mov r1, r0                       ; zero the whole new segment
    mov r2, [sbrk_newpages]
    shl r2, PAGE_SHIFT_FAC
    call proc_memzero
    mov r0, [sbrk_newbase]           ; copy old contents across (dst = r0)
    mov r1, [sbrk_oldbase]
    mov r2, [sbrk_oldmlen]
    cpy r1, r2
    mov r4, [curproc]                ; repoint the PCB at the new segment
    mov r0, [sbrk_newbase]
    vstore r4, PCB_MBASE, r0, r1
    vstore r4, PCB_USEG, r0, r1
    mov r0, [sbrk_newpages]
    vstore r4, PCB_UPAGES, r0, r1
    mov r0, [sbrk_newpages]
    shl r0, PAGE_SHIFT_FAC
    vstore r4, PCB_MLEN, r0, r1
    mov r3, [sbrk_frame]             ; repoint the live frame that iret will restore
    mov r0, r3
    add r0, FRM_MBASE
    mov r1, [sbrk_newbase]
    mov [r0], r1
    mov r0, r3
    add r0, FRM_MLEN
    mov r1, [sbrk_newpages]
    shl r1, PAGE_SHIFT_FAC
    mov [r0], r1
    mov r1, [sbrk_oldbase]           ; free the old segment
    mov r2, [sbrk_oldpages]
    call freepages
    mov r0, [sbrk_oldmlen]           ; base of the new region in the caller's space
    jmp sysret
    .fail:
    mov r0, -1
    jmp sysret


; Copy a null-terminated string from the kernel out to the current process's
; user address space, bounded by a capacity.
; r1 - kernel source string
; r2 - user destination pointer
; r3 - destination capacity in bytes
; returns r0 = 0 on success, -1 if it ran out of bounds or capacity
copyoutstr:
    push r4                      ; segment base
    push r5                      ; segment length
    push r6                      ; user offset
    push r7                      ; source cursor
    mov r0, [curproc]
    vload r4, r0, PCB_MBASE
    vload r5, r0, PCB_MLEN
    mov r6, r2
    mov r7, r1
    .loop:
        cmp r3, 0
        je .fault                ; out of destination capacity
        cmp r6, r5
        juge .fault              ; user offset outside the segment
        mov8 r0, [r7]            ; source byte
        mov r1, r6
        add r1, r4               ; physical destination
        mov8 [r1], r0
        cmp r0, 0
        je .ok                   ; wrote the terminator
        add r6, 1
        add r7, 1
        sub r3, 1
        jmp .loop
    .ok:
    mov r0, 0
    jmp .done
    .fault:
    mov r0, -1
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; SYS_PSLIST (r2 = dst, r3 = capacity in records): describe the process table to
; userland - one record of [pid, parent pid, state, name] per slot in use, written
; in slot order, returning how many were written. That is the whole of what a
; program can learn about another process, and it is deliberately unprivileged: a
; pid is not a capability in this kernel (SYS_KILL already takes any pid and scans
; for it), so being able to see one grants nothing that guessing would not. It is
; what lets `ps` and `pkill` be ordinary programs instead of kernel features.
;
; The name is copied out of the PCB's own inline field, so it is valid regardless
; of what has happened to the buffer the program was spawned from, and the whole
; fixed-size field is copied - userland stops at the terminator.
; Returns the number of records written, or -1 on a bounds fault.
sys_pslist_h:
    cmp r3, MAX_PROCS
    jule .capok                  ; clamp before multiplying: a wild capacity would
    mov r3, MAX_PROCS            ; overflow the byte count and slip past uaddr
    .capok:
    mov r1, r2                   ; user destination
    mov r2, r3
    umul r2, PSREC_BYTES
    call uaddr                   ; r0 = physical base, checked over the whole range
    cmp r0, 0
    je .fail
    mov r7, r0                   ; destination cursor
    mov r4, 0                    ; records written
    mov r5, proctable            ; PCB cursor
    mov r6, 0                    ; slot index
    .loop:
        cmp r6, MAX_PROCS
        juge .done
        cmp r4, r3               ; hit the caller's capacity?
        juge .done
        mov r0, [r5]             ; PCB_STATE
        cmp r0, PROC_FREE
        je .next                 ; an unused slot is not a process
        vload r1, r5, PCB_PID
        mov [r7], r1
        add r7, 4
        vload r1, r5, PCB_PPID
        mov [r7], r1
        add r7, 4
        mov [r7], r0             ; state, as one of PROC_*
        add r7, 4
        mov r0, r7               ; name (cpy takes its destination from r0)
        mov r1, r5
        add r1, PCB_NAME
        cpy r1, PROC_NAME_MAX
        add r7, PROC_NAME_MAX
        add r4, 1
        .next:
        add r5, PCB_STRUCT
        add r6, 1
        jmp .loop
    .done:
    mov r0, r4
    jmp sysret
    .fail:
    mov r0, -1
    jmp sysret


; ==========================
;   The foreground job of a terminal
; ==========================
; What the interrupt key (Ctrl+C, see console.cat and pty.cat) has to answer: of
; everything attached to this terminal, which process is the one you are waiting
; on? There are no process groups here and no controlling-terminal ownership - a
; PCB records a tty *path* and that is all - so the answer is read out of the wait
; graph instead, and it is exact enough because a shell's whole relationship with a
; foreground job is that it is blocked in wait() for it:
;
;   * a process nobody on this terminal is waiting for is a background job - a
;     window manager started with "bg", a "gdemo &". Ctrl+C must not touch those,
;     and this is what keeps its hands off them;
;   * a candidate that is itself waiting for another process on this terminal is a
;     supervisor, not the job: init waits on the shell exactly as the shell waits on
;     the command it ran, so only the innermost link of that chain is signalled and
;     the shell (and init) are never it;
;   * a candidate blocked reading this terminal is sitting at a prompt. There is
;     nothing running to interrupt, so the caller clears the line it was editing
;     instead - which is the whole reason this returns a count.
;
; That last rule is also the limitation worth being honest about: a foreground
; program that blocks reading the terminal is indistinguishable from a shell doing
; the same, so Ctrl+C clears its line rather than killing it. Distinguishing them
; needs the terminal to be told which job is in the foreground - process groups -
; and until something asks for that, "the program waiting for you keeps its line,
; the program ignoring you gets signalled" is the rule, and pkill covers the rest.

; Is this PCB a live process attached to a given terminal?
; r1 - PCB pointer, r2 - tty path -> r0 = 1 / 0. Clobbers r0-r3.
proc_tty_match:
    mov r0, [r1]                 ; PCB_STATE
    cmp r0, PROC_FREE
    je .no                       ; an unused slot is not a process
    cmp r0, PROC_ZOMBIE
    je .no                       ; nor is a dead one: it runs nothing to interrupt
    add r1, PCB_TTY
    call vfsstreq
    ret
    .no:
    mov r0, 0
    ret


; Is some process on this terminal blocked in wait() for pid r1? That is the
; definition of a foreground job here.
; r1 - pid, r2 - tty path -> r0 = 1 / 0
proc_tty_waited:
    push r4                      ; pid
    push r5                      ; tty path
    push r6                      ; PCB cursor
    push r7                      ; slot index
    mov r4, r1
    mov r5, r2
    mov r6, proctable
    mov r7, 0
    .loop:
        cmp r7, MAX_PROCS
        juge .no
        mov r0, [r6]             ; only a blocked process is waiting for anything
        cmp r0, PROC_BLOCKED
        jne .next
        vload r0, r6, PCB_CHAN   ; a waiter blocks on the pid it is waiting for
        cmp r0, r4
        jne .next
        mov r1, r6
        mov r2, r5
        call proc_tty_match
        cmp r0, 0
        jne .yes
        .next:
        add r6, PCB_STRUCT
        add r7, 1
        jmp .loop
    .yes:
    mov r0, 1
    jmp .done
    .no:
    mov r0, 0
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Is this process itself waiting for another process on the same terminal - i.e. is
; it a link in the wait chain rather than the end of it? A read that blocked parks
; on a *node* address rather than a pid, so it never matches one of these and a
; process waiting for input is correctly the end of the chain.
; r1 - PCB pointer, r2 - tty path -> r0 = 1 / 0
proc_tty_inner:
    push r4                      ; the pid it is blocked on
    push r5                      ; tty path
    push r6                      ; PCB cursor
    push r7                      ; slot index
    mov r0, [r1]
    cmp r0, PROC_BLOCKED
    jne .no
    vload r4, r1, PCB_CHAN
    mov r5, r2
    mov r6, proctable
    mov r7, 0
    .loop:
        cmp r7, MAX_PROCS
        juge .no
        mov r1, r6
        mov r2, r5
        call proc_tty_match
        cmp r0, 0
        je .next
        vload r0, r6, PCB_PID
        cmp r0, r4
        je .yes
        .next:
        add r6, PCB_STRUCT
        add r7, 1
        jmp .loop
    .yes:
    mov r0, 1
    jmp .done
    .no:
    mov r0, 0
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Signal every foreground job of a terminal, by the rules in the banner above.
; Called from a line discipline when the interrupt character arrives, so it must be
; safe from an interrupt handler: it only sets pending bits and marks processes
; runnable, and never switches away.
; r1 - tty path, r2 - the terminal's node (the channel a reader of it blocks on)
; -> r0 = how many processes were signalled (0 = nothing was running)
proc_tty_intr:
    push r4                      ; tty path
    push r5                      ; tty node
    push r6                      ; PCB cursor
    push r7                      ; processes signalled
    mov r4, r1
    mov r5, r2
    mov r6, proctable
    mov r7, 0
    .loop:
        mov r0, proctable        ; the cursor is the loop variable, so that the slot
        add r0, MAX_PROCS * PCB_STRUCT   ; index does not need a register of its own
        cmp r6, r0
        juge .done
        mov r1, r6
        mov r2, r4
        call proc_tty_match
        cmp r0, 0
        je .next                 ; not a live process on this terminal
        vload r1, r6, PCB_PID
        mov r2, r4
        call proc_tty_waited
        cmp r0, 0
        je .next                 ; nobody is waiting for it: a background job
        mov r1, r6
        mov r2, r4
        call proc_tty_inner
        cmp r0, 0
        jne .next                ; a supervisor of something deeper on this terminal
        mov r0, [r6]
        cmp r0, PROC_BLOCKED
        jne .signal
        vload r0, r6, PCB_CHAN
        cmp r0, r5
        je .next                 ; blocked reading this terminal: it is at a prompt
        .signal:
        mov r1, r6
        mov r2, SIGTERM          ; the same polite request a window's close button
        call sig_raise           ; makes, so a program can catch it and clean up
        add r7, 1
        .next:
        add r6, PCB_STRUCT
        jmp .loop
    .done:
    mov r0, r7
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Wake every process blocked on a channel (mark them READY, clear the channel).
; r1 - channel value
proc_wakeup:
    push r4                      ; channel
    push r5                      ; cursor
    push r6                      ; count
    mov r4, r1
    mov r5, proctable
    mov r6, 0
    .loop:
        cmp r6, MAX_PROCS
        juge .done
        mov r0, [r5]             ; PCB_STATE
        cmp r0, PROC_BLOCKED
        jne .next
        vload r0, r5, PCB_CHAN
        cmp r0, r4
        jne .next
        mov r0, PROC_READY
        mov [r5], r0
        mov r0, 0
        vstore r5, PCB_CHAN, r0, r1
        .next:
        add r5, PCB_STRUCT
        add r6, 1
        jmp .loop
    .done:
    pop r6
    pop r5
    pop r4
    ret
