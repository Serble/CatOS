; ==========================
;   CatOS system calls
; ==========================
; The controlled entry point from a task into the kernel. User code runs the
; `syscall` instruction, which raises interrupt 0x10; this dispatcher (which
; registers itself with the interrupt manager) decodes the request and returns
; a result. It is the mechanism the future process system will build on for
; things like yielding, spawning and I/O.
;
;
; -- Convention -------------------------------------------------------------
;
;   in : r1 = syscall number, r2 / r3 = arguments
;   out: r0 = result
;   r1-r3 are clobbered, r4-r7 are preserved (same split as a normal call).
;
;
; -- Returning a value across iret ------------------------------------------
;
; How the result gets back to the caller depends on the caller's privilege
; when `syscall` ran, because the CPU builds a different interrupt frame for
; each and `iret` undoes exactly what was built:
;
;   * Kernel caller: the frame holds only ip (+ marker); iret restores nothing
;     else, so the live r0 we set simply survives. This is the path exercised
;     today, before any user-mode processes exist.
;
;   * User / supervisor caller: the frame holds the full register set and iret
;     reloads r0-r7 from it, so a live r0 would be overwritten. We instead
;     write the result into the frame's saved r0 slot.
;
; The CPU pushes the user frame low->high address as: marker(1 byte), ip(4),
; sp(4), fl(4), mbase(4), mlen(4), then r7,r6,r5,r4,r3,r2,r1,r0 (4 each). On
; handler entry sp points at the marker, so the saved r0 sits 1 + 4*12 = 49
; bytes above sp.

#define INT_SYSCALL, 0x10        ; interrupt raised by the `syscall` instruction

#define FRAME_KERNEL, 0          ; interrupt-frame marker for a kernel-mode frame
#define FRAME_DRIVER, 2          ; ... and for a driver-mode one (drvhost.cat); it
                                 ; has the same layout as a user-mode frame
#define SYSFRAME_R0, 49          ; offset of saved r0 in a user-mode frame

; ---- syscall numbers (keep in sync with user/sys.cat) ----
#define SYS_TEST, 0              ; returns 7, purely to prove the path works
#define SYS_YIELD, 1            ; give up the CPU (proc-mgmt, sched.cat)
#define SYS_EXIT, 2            ; terminate the caller (proc-mgmt, sched.cat)
#define SYS_GETPID, 3          ; return the caller's pid (proc-mgmt, sched.cat)
#define SYS_WAIT, 4            ; wait for a child to exit (proc-mgmt, sched.cat)
#define SYS_PRINT, 5           ; debug: print r2 as a number (temporary)
#define SYS_SPAWN, 6          ; load a program by path and run it (exec.cat)
#define SYS_OPEN, 7           ; open a path -> fd (fdio.cat)
#define SYS_CLOSE, 8          ; close an fd
#define SYS_READ, 9           ; read from an fd
#define SYS_WRITE, 10         ; write to an fd
#define SYS_SEEK, 11          ; move an fd's cursor
#define SYS_READDIR, 12       ; read the next directory entry name
#define SYS_CREATE, 13        ; create a file or directory
#define SYS_SIGNAL, 14        ; install a signal disposition (signal.cat)
#define SYS_KILL, 15          ; send a signal to a process (signal.cat)
#define SYS_CHDIR, 16         ; change the working directory (fdio.cat)
#define SYS_GETCWD, 17        ; read the working directory (fdio.cat)
#define SYS_POWEROFF, 18      ; power the machine off via the hardware manager
#define SYS_GACQUIRE, 19      ; take over the screen / linear framebuffer (wm.cat)
#define SYS_GRELEASE, 20      ; hand the screen back to the text console
#define SYS_GPRESENT, 24      ; flush the framebuffer to the display
#define SYS_MOUSE, 25         ; read the mouse state
#define SYS_WCREATE, 26       ; create a window surface (client)
#define SYS_WCOMMIT, 27       ; upload pixels into a surface (client)
#define SYS_WLIST, 28         ; list live surfaces (compositor)
#define SYS_SBRK, 29          ; grow the caller's memory segment (proc.cat)
#define SYS_WREAD, 30         ; copy a surface's pixels to the caller (compositor)
#define SYS_GKEY, 31          ; take a queued grabbed key (display.cat)
#define SYS_CONREAD, 32       ; snapshot the text console grid (console.cat)
#define SYS_WCONFIG, 33       ; read a surface's granted size (surface.cat)
#define SYS_WRESIZE, 34       ; grant a surface a size (surface.cat)
#define SYS_KEYGRAB, 35       ; claim a keycode for the screen owner (display.cat)
#define SYS_WPOST, 36         ; route the pointer to a surface (surface.cat)
#define SYS_WINPUT, 37        ; read the pointer over your own surface (surface.cat)
#define SYS_PSLIST, 38        ; list the live processes (proc.cat)
#define SYS_WKEYPOST, 39      ; route a key to a surface (surface.cat)
#define SYS_WKEY, 40          ; take a key posted to your own surface (surface.cat)
#define SYS_MOUNT, 41         ; mount a filesystem on a path (fdio.cat)
#define SYS_UMOUNT, 42        ; unmount the filesystem at a path (fdio.cat)
#define SYS_STAT, 43          ; read a path's type, size and flags (fdio.cat)
#define SYS_REMOVE, 44        ; unlink a file or empty directory (fdio.cat)
#define SYS_RENAME, 45        ; move an entry within one filesystem (fdio.cat)
#define SYS_CONKEY, 46        ; type a key into the console session (display.cat)
#define SYS_PTYNEW, 47        ; claim a pseudo-terminal session (pty.cat)
#define SYS_PTYGRID, 48       ; snapshot one's character grid (pty.cat)
#define SYS_PTYKEY, 49        ; type a key into one (pty.cat)
#define SYS_PTYCLOSE, 50      ; release one (pty.cat)
#define SYS_SETTTY, 51        ; set the controlling terminal, inherited by
                              ; children (fdio.cat)
#define SYS_REBOOT, 52        ; reset the machine and boot again (hwman.cat)
#define SYS_DRVLOAD, 53       ; load a driver from a file (drvhost.cat)
#define SYS_DRVLIST, 54       ; list the loaded drivers (drvhost.cat)


; Register the syscall dispatcher. Call once at boot, after intinit.
; returns r0 = 0 on success, -1 if the interrupt table was full
syscallinit:
    mov r1, INT_SYSCALL
    mov r2, syscall_handler
    call intregister
    ret


; Deliver a result to the caller across iret and return. r0 = value; requires
; sp to still point at the caller's frame (so reach it with `jmp sysret`, never
; `call`). Handles both kernel callers (live r0 survives) and user callers (the
; saved r0 in the frame is patched). A user caller then passes through
; sysret_user (signal.cat) so any signal that came due during the syscall is
; delivered on the way back out to user mode.
sysret:
    mov8 r2, [sp]                ; frame marker (nothing pushed, so sp = frame)
    cmp r2, FRAME_KERNEL
    je .k                        ; kernel caller: keep the live r0
    mov r2, sp                   ; user caller: patch the saved r0
    add r2, SYSFRAME_R0
    mov [r2], r0
    jmp sysret_user              ; deliver pending signals, then iret / switch
    .k:
    iret


; The syscall dispatcher (interrupt 0x10 handler). Decodes r1. Process-control
; calls jump to their handlers in sched.cat with the frame still at sp; the rest
; compute r0 and jump to sysret. A `syscall` from a loaded driver is one of the
; driver calls instead, a separate set with its own numbers (drvhost.cat).
syscall_handler:
    mov8 r0, [sp]                ; frame marker (r0 is the result, so it is free)
    cmp r0, FRAME_DRIVER
    je drv_syscall
    cmp r1, SYS_YIELD
    je sys_yield_h
    cmp r1, SYS_EXIT
    je sys_exit_h
    cmp r1, SYS_WAIT
    je sys_wait_h
    cmp r1, SYS_GETPID
    je sys_getpid_h
    cmp r1, SYS_SPAWN
    je sys_spawn_h
    cmp r1, SYS_OPEN
    je sys_open_h
    cmp r1, SYS_CLOSE
    je sys_close_h
    cmp r1, SYS_READ
    je sys_read_h
    cmp r1, SYS_WRITE
    je sys_write_h
    cmp r1, SYS_SEEK
    je sys_seek_h
    cmp r1, SYS_READDIR
    je sys_readdir_h
    cmp r1, SYS_CREATE
    je sys_create_h
    cmp r1, SYS_STAT
    je sys_stat_h
    cmp r1, SYS_REMOVE
    je sys_remove_h
    cmp r1, SYS_RENAME
    je sys_rename_h
    cmp r1, SYS_SIGNAL
    je sys_signal_h
    cmp r1, SYS_KILL
    je sys_kill_h
    cmp r1, SYS_CHDIR
    je sys_chdir_h
    cmp r1, SYS_GETCWD
    je sys_getcwd_h
    cmp r1, SYS_POWEROFF
    je sys_poweroff_h
    cmp r1, SYS_REBOOT
    je sys_reboot_h
    cmp r1, SYS_GACQUIRE
    je gfx_acquire_h
    cmp r1, SYS_GRELEASE
    je gfx_release_h
    cmp r1, SYS_GPRESENT
    je gfx_present_h
    cmp r1, SYS_MOUSE
    je gfx_mouse_h
    cmp r1, SYS_WCREATE
    je surf_create_h
    cmp r1, SYS_WCOMMIT
    je surf_commit_h
    cmp r1, SYS_WLIST
    je surf_list_h
    cmp r1, SYS_WREAD
    je surf_read_h
    cmp r1, SYS_WCONFIG
    je surf_config_h
    cmp r1, SYS_WRESIZE
    je surf_resize_h
    cmp r1, SYS_WPOST
    je surf_post_h
    cmp r1, SYS_WINPUT
    je surf_input_h
    cmp r1, SYS_WKEYPOST
    je surf_keypost_h
    cmp r1, SYS_WKEY
    je surf_key_h
    cmp r1, SYS_GKEY
    je input_key_h
    cmp r1, SYS_KEYGRAB
    je input_grab_h
    cmp r1, SYS_CONREAD
    je sys_conread_h
    cmp r1, SYS_CONKEY
    je sys_conkey_h
    cmp r1, SYS_PTYNEW
    je sys_ptynew_h
    cmp r1, SYS_PTYGRID
    je sys_ptygrid_h
    cmp r1, SYS_PTYKEY
    je sys_ptykey_h
    cmp r1, SYS_PTYCLOSE
    je sys_ptyclose_h
    cmp r1, SYS_SETTTY
    je sys_settty_h
    cmp r1, SYS_SBRK
    je sys_sbrk_h
    cmp r1, SYS_MOUNT
    je sys_mount_h
    cmp r1, SYS_UMOUNT
    je sys_umount_h
    cmp r1, SYS_PSLIST
    je sys_pslist_h
    cmp r1, SYS_DRVLOAD
    je sys_drvload_h
    cmp r1, SYS_DRVLIST
    je sys_drvlist_h
    cmp r1, SYS_PRINT
    je .print
    cmp r1, SYS_TEST
    je .test
    mov r0, -1                   ; unknown syscall number
    jmp sysret
    .test:
    mov r0, 7
    jmp sysret
    .print:                      ; debug output until /dev/console exists
    mov r1, r2
    int 0x90
    mov r0, 0
    jmp sysret


; SYS_POWEROFF: power the machine off through the hardware manager. Does not
; return; if the hardware somehow keeps running we freeze the machine instead.
sys_poweroff_h:
    call hwshutdown
    call hwhalt
    .spin:
    jmp .spin


; SYS_REBOOT: reset the machine and come up again through the firmware, which
; reloads the kernel off the disk - so a rebuilt image is what boots. Does not
; return, and needs no teardown of its own: every filesystem write is already
; committed by the time a syscall returns (CatFS journals per operation and the
; disk driver waits for each block), so there is nothing buffered to lose, and
; the reset takes memory, processes and devices with it regardless. If the
; hardware ignores us we freeze rather than pretend the call failed.
sys_reboot_h:
    call hwreset
    .spin:
    jmp .spin
