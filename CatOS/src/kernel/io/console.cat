; ==========================
;   CatOS console (device-agnostic text terminal)
; ==========================
; The generic text console. It owns the cursor, newline/scroll behaviour, and a
; line-disciplined input buffer, and it publishes /dev/console (a char device)
; so reads and writes go through the ordinary VFS + syscalls.
;
; It is NOT tied to any particular display hardware. Rendering goes through a
; small "display driver" vtable that a backend registers via console_set_display;
; input comes in through console_input_char, which any input backend can call.
; The Raylib PPU (raylibppu.cat) is one such backend - a serial-terminal or a
; different framebuffer could be dropped in without touching this file.
;
;
; -- Display driver vtable --------------------------------------------------
;
; A backend supplies a table of four routines and its screen dimensions in
; character cells. The console calls them; none of them return anything.
;
;   DISP_PUTC   putc(r1=col, r2=row, r3=char)  draw one glyph in a cell
;   DISP_SCROLL scroll()                        move everything up one row
;   DISP_CLEAR  clear()                         blank the whole screen
;   DISP_PRESENT present()                       flush the backbuffer to screen
;
;
; -- The text mirror ---------------------------------------------------------
;
; Alongside whatever the backend does, the console keeps its own plain character
; grid (console_cells, packed at the live geometry). That grid is what makes the
; console renderable by something other than its backend: SYS_CONREAD hands a
; snapshot of it - dimensions, cursor and all - to a user program, so a graphical
; program can draw the shell itself while the display is in a mode its text
; backend cannot drive.
;
; While another process holds the screen, the display service registers
; console_null_ops here - a backend that draws nowhere - at whatever geometry that
; process asked for. The console stays completely live, it just has no hardware
; behind it until the screen is handed back.

#define DISP_PUTC, 0
#define DISP_SCROLL, 4
#define DISP_CLEAR, 8
#define DISP_PRESENT, 12

#define CON_INTR, 3              ; the interrupt character (Ctrl+C). A *character*,
                                 ; not a keycode: the keyboard layout says what
                                 ; CTRL and a letter make (raylibppu.cat), so a line
                                 ; discipline recognises the interrupt key without
                                 ; knowing anything about keyboards - and so does a
                                 ; pty, which has no keyboard in front of it at all.
#define CON_LINE_MAX, 255        ; longest editable input line
#define CON_RING_SIZE, 512       ; completed-input byte ring capacity
#define CON_MAX_COLS, 64         ; mirror capacity - must fit every backend's
#define CON_MAX_ROWS, 24         ; geometry (32x24 tiled, 64x23 graphical)
#define CON_HDR, 20              ; SYS_CONREAD header: cols, rows, col, row, seq


; ---- state ----
console_disp:
    d32 0                        ; display vtable, 0 = no display yet
console_cols:
    d32 0
console_rows:
    d32 0
console_col:
    d32 0                        ; cursor column
console_row:
    d32 0                        ; cursor row
console_node:
    d32 0                        ; the /dev/console node (wakeup channel)
console_linelen:
    d32 0                        ; chars in the line being edited
console_rhead:
    d32 0                        ; input ring read cursor
console_rtail:
    d32 0                        ; input ring write cursor
console_line:
    res8 CON_LINE_MAX + 1
console_ring:
    res8 CON_RING_SIZE
console_cells:
    res8 CON_MAX_COLS * CON_MAX_ROWS   ; the text mirror (see the header)
console_scratch:
    res8 CON_MAX_COLS * CON_MAX_ROWS   ; the old grid while it is being reflowed
console_rf_ocols:
    d32 0                        ; reflow: the geometry the scratch copy is at
console_rf_first:
    d32 0                        ; reflow: first old row carried to the new grid
console_seq:
    d32 0                        ; bumped on every change to what the console shows,
                                 ; so a reader can tell "nothing happened" in one
                                 ; compare instead of diffing the whole grid

consolepath:
    dstr "/dev/console\0"


; ==========================
;   Display vtable wrappers
; ==========================
; Each loads the registered backend and dispatches, or does nothing if no
; display is registered. Args are passed straight through.

disp_putc:                       ; r1=col, r2=row, r3=char
    mov r0, [console_disp]
    cmp r0, 0
    je .none
    mov r0, [r0]                 ; DISP_PUTC (offset 0)
    call r0
    .none:
    ret

disp_scroll:
    mov r0, [console_disp]
    cmp r0, 0
    je .none
    add r0, DISP_SCROLL
    mov r0, [r0]
    call r0
    .none:
    ret

disp_clear:
    mov r0, [console_disp]
    cmp r0, 0
    je .none
    add r0, DISP_CLEAR
    mov r0, [r0]
    call r0
    .none:
    ret

disp_present:
    mov r0, [console_disp]
    cmp r0, 0
    je .none
    add r0, DISP_PRESENT
    mov r0, [r0]
    call r0
    .none:
    ret


; A backend that draws nowhere. Registered while another process owns the screen
; (see gfx_acquire_h): the mirror still tracks every character, so the console is
; live and readable through SYS_CONREAD, it simply has no hardware behind it.
console_null_noop:
    ret

console_null_ops:
    d32 console_null_noop        ; DISP_PUTC
    d32 console_null_noop        ; DISP_SCROLL
    d32 console_null_noop        ; DISP_CLEAR
    d32 console_null_noop        ; DISP_PRESENT


; Register a display backend and its size in character cells, reflowing the
; session onto the new grid and repainting the backend from it.
;
; The mirror is packed at the live geometry, so changing geometry means rebuilding
; it. Rather than throw the session away we keep the block of rows ending at the
; cursor - everything you can currently see, oldest lines dropped first if the new
; grid is shorter - and truncate columns. That is what makes entering and leaving
; a graphical program taking the screen seamless: your shell is still there, at a
; different size, on both sides of the switch.
; r1 - display vtable, r2 - columns, r3 - rows
console_set_display:
    push r4                      ; new columns
    push r5                      ; new rows
    push r6                      ; rows carried over
    push r7                      ; row index
    mov [console_disp], r1
    mov r4, r2
    mov r5, r3
    mov r0, [console_seq]        ; a geometry change invalidates everything a reader
    add r0, 1                    ; may have cached
    mov [console_seq], r0
    mov r0, [console_cols]
    mov [console_rf_ocols], r0
    call console_mirror_save     ; the old grid, at the old geometry

    mov r0, [console_row]        ; first = max(0, cursor row - (new rows - 1))
    mov r1, r5
    sub r1, 1
    cmp r0, r1
    juge .clip
    mov r0, 0
    jmp .havefirst
    .clip:
    sub r0, r1
    .havefirst:
    mov [console_rf_first], r0
    mov r6, [console_rows]       ; count = min(old rows - first, new rows)
    sub r6, r0
    cmp r6, r5
    jule .havecount
    mov r6, r5
    .havecount:
    cmp r6, 0
    jile .nocarry

    mov r0, [console_row]        ; the cursor moves with its block of rows
    mov r1, [console_rf_first]
    sub r0, r1
    mov [console_row], r0
    mov r0, [console_col]        ; and is pulled inside the narrower grid
    cmp r0, r4
    jul .colok
    mov r0, r4
    sub r0, 1
    .colok:
    mov [console_col], r0
    jmp .adopt

    .nocarry:                    ; nothing to keep (first registration)
    mov r6, 0
    mov r0, 0
    mov [console_col], r0
    mov [console_row], r0

    .adopt:
    mov [console_cols], r4
    mov [console_rows], r5
    call console_mirror_clear
    mov r7, 0
    .rows:
        cmp r7, r6
        juge .paint
        mov r1, r7
        call console_reflow_row
        add r7, 1
        jmp .rows
    .paint:
    call disp_clear
    call console_repaint
    call disp_present
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; ==========================
;   Text mirror
; ==========================

; Record one glyph in the mirror. Out-of-range cells are dropped rather than
; scribbling past the grid. r1 = col, r2 = row, r3 = char
console_mirror_putc:
    mov r0, [console_cols]
    umul r0, r2                  ; row * cols
    add r0, r1                   ; + col
    cmp r0, CON_MAX_COLS * CON_MAX_ROWS
    juge .oob
    add r0, console_cells
    mov8 [r0], r3
    .oob:
    ret


; Copy the live mirror aside so console_set_display can reflow it onto a new
; geometry without reading and writing the same grid at two different strides.
console_mirror_save:
    mov r0, console_scratch
    mov r1, console_cells
    cpy r1, CON_MAX_COLS * CON_MAX_ROWS
    ret


; Copy one carried row out of the saved grid and into the reflowed mirror,
; truncating to whichever grid is narrower. r1 = row index (source rows start at
; console_rf_first; destinations are top-aligned).
console_reflow_row:
    push r4                      ; source address
    push r5                      ; destination address
    push r6                      ; columns to copy
    mov r0, [console_rf_first]
    add r0, r1                   ; source row
    mov r4, [console_rf_ocols]
    umul r0, r4
    add r0, console_scratch
    mov r4, r0
    mov r0, r1                   ; destination row = the same index
    mov r5, [console_cols]
    umul r0, r5
    add r0, console_cells
    mov r5, r0
    mov r6, [console_rf_ocols]   ; min(old columns, new columns)
    mov r0, [console_cols]
    cmp r6, r0
    jule .have
    mov r6, r0
    .have:
    cmp r6, 0
    je .done
    mov r0, r5
    mov r1, r4
    mov r2, r6
    cpy r1, r2
    .done:
    pop r6
    pop r5
    pop r4
    ret


; Push every non-blank mirror cell at the backend, so a display that has just been
; registered shows the session instead of an empty screen.
console_repaint:
    push r4                      ; row
    push r5                      ; column
    push r6                      ; row base in the mirror
    push r7                      ; character
    mov r4, 0
    .rows:
        mov r0, [console_rows]
        cmp r4, r0
        juge .done
        mov r6, r4
        mov r0, [console_cols]
        umul r6, r0
        add r6, console_cells
        mov r5, 0
        .cols:
            mov r0, [console_cols]
            cmp r5, r0
            juge .nextrow
            mov r0, r6
            add r0, r5
            mov8 r7, [r0]
            cmp r7, 32
            jule .nextcol        ; blank / control -> leave the cell cleared
            mov r1, r5
            mov r2, r4
            mov r3, r7
            call disp_putc
            .nextcol:
            add r5, 1
            jmp .cols
        .nextrow:
        add r4, 1
        jmp .rows
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Blank the whole mirror (the full capacity, not just the live geometry, so no
; stale characters survive a geometry change).
console_mirror_clear:
    push r4
    mov r0, console_cells
    mov r4, CON_MAX_COLS * CON_MAX_ROWS
    .loop:
        mov8 [r0], 32
        add r0, 1
        sub r4, 1
        cmp r4, 0
        jne .loop
    pop r4
    ret


; Shift the mirror up one row and blank the last one. Copied row by row so the
; source and destination of each `cpy` never overlap.
console_mirror_scroll:
    push r4                      ; row index
    push r5                      ; bytes per row (= columns)
    push r6                      ; rows
    mov r5, [console_cols]
    mov r6, [console_rows]
    mov r4, 0
    .rows:
        mov r0, r6
        sub r0, 1
        cmp r4, r0
        juge .blank
        mov r0, r4               ; dst = cells + row*cols
        umul r0, r5
        add r0, console_cells
        mov r1, r4               ; src = cells + (row+1)*cols
        add r1, 1
        umul r1, r5
        add r1, console_cells
        cpy r1, r5
        add r4, 1
        jmp .rows
    .blank:
    mov r0, r6                   ; blank the now-duplicated last row
    sub r0, 1
    umul r0, r5
    add r0, console_cells
    mov r1, r5
    .clr:
        cmp r1, 0
        je .done
        mov8 [r0], 32
        add r0, 1
        sub r1, 1
        jmp .clr
    .done:
    pop r6
    pop r5
    pop r4
    ret


; SYS_CONREAD (r2 = dst, r3 = capacity): snapshot the console into the caller's
; buffer as a CON_HDR header - columns, rows, cursor column, cursor row, change
; counter - followed by columns*rows characters, row-major. A reader that has seen
; the same counter before knows the console is unchanged and can skip redrawing it.
; Returns the number of bytes written, or -1 if the buffer is too small or out of
; bounds.
sys_conread_h:
    push r4                      ; user destination
    push r5                      ; grid bytes
    mov r4, r2
    mov r5, [console_rows]
    mov r0, [console_cols]
    umul r5, r0                  ; rows * cols
    mov r0, r5
    add r0, CON_HDR              ; total bytes the caller must have room for
    cmp r3, r0
    jul .fail
    mov r1, r4                   ; validate the whole destination range
    mov r2, r0
    call uaddr
    cmp r0, 0
    je .fail
    mov r1, r0                   ; write the header
    mov r0, [console_cols]
    mov [r1], r0
    add r1, 4
    mov r0, [console_rows]
    mov [r1], r0
    add r1, 4
    mov r0, [console_col]
    mov [r1], r0
    add r1, 4
    mov r0, [console_row]
    mov [r1], r0
    add r1, 4
    mov r0, [console_seq]
    mov [r1], r0
    add r1, 4
    mov r0, r1                   ; then the grid itself
    mov r1, console_cells
    mov r2, r5
    cpy r1, r2
    mov r0, r5
    add r0, CON_HDR
    pop r5
    pop r4
    jmp sysret
    .fail:
    mov r0, -1
    pop r5
    pop r4
    jmp sysret


; ==========================
;   Output
; ==========================

; Emit one character at the cursor, handling newline, carriage return,
; backspace and wrapping/scrolling. Does not present (callers batch).
; r1 - character
console_putc:
    push r4
    mov r4, r1
    mov r0, [console_seq]        ; the grid or the cursor is about to move; bumping
    add r0, 1                    ; here (rather than in the mirror writes) also
    mov [console_seq], r0        ; catches a bare newline moving the cursor
    cmp r4, 10                   ; \n
    je .newline
    cmp r4, 13                   ; \r -> ignore
    je .ret
    cmp r4, 8                    ; backspace
    je .backspace

    mov r1, [console_col]        ; draw the glyph at the cursor
    mov r2, [console_row]
    mov r3, r4
    call disp_putc
    mov r1, [console_col]        ; ... and record it in the mirror
    mov r2, [console_row]
    mov r3, r4
    call console_mirror_putc
    mov r0, [console_col]
    add r0, 1
    mov [console_col], r0
    mov r1, [console_cols]
    cmp r0, r1
    jul .ret
    jmp .newline                 ; wrapped past the last column

    .backspace:
    mov r0, [console_col]
    cmp r0, 0
    je .ret                      ; already at column 0
    sub r0, 1
    mov [console_col], r0
    mov r1, r0                   ; erase by drawing a space
    mov r2, [console_row]
    mov r3, 32
    call disp_putc
    mov r1, [console_col]
    mov r2, [console_row]
    mov r3, 32
    call console_mirror_putc
    jmp .ret

    .newline:
    mov r0, 0
    mov [console_col], r0
    mov r0, [console_row]
    add r0, 1
    mov r1, [console_rows]
    cmp r0, r1
    jul .setrow
    call disp_scroll             ; off the bottom -> scroll, stay on last row
    call console_mirror_scroll
    mov r0, [console_rows]
    sub r0, 1
    .setrow:
    mov [console_row], r0

    .ret:
    pop r4
    ret


; /dev/console write(r1=node, r2=off, r3=buf, [sp]=len) -> r0 = bytes written.
; buf is a physical (kernel) address supplied by the syscall layer.
console_write:
    push r4                      ; buffer
    push r5                      ; remaining
    push r6                      ; total (return)
    push r7                      ; len slot
    mov r4, r3
    mov r7, sp
    add r7, 20
    mov r5, [r7]                 ; len
    mov r6, r5
    .loop:
        cmp r5, 0
        je .done
        mov8 r1, [r4]
        call console_putc
        add r4, 1
        sub r5, 1
        jmp .loop
    .done:
    call disp_present            ; flush once for the whole write
    mov r0, r6
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; ==========================
;   Input
; ==========================

; Push one byte into the completed-input ring (drops it if the ring is full).
; Single-producer/single-consumer: the input backend only advances rtail and
; the reader only advances rhead, so no locking is needed.
; r1 - byte
console_ring_push:
    mov r0, [console_rtail]
    mov r2, r0
    add r2, 1
    cmp r2, CON_RING_SIZE
    jul .nowrap
    mov r2, 0
    .nowrap:
    mov r3, [console_rhead]
    cmp r2, r3
    je .full                     ; would collide with the reader -> drop
    mov r3, console_ring
    add r3, r0
    mov8 [r3], r1
    mov [console_rtail], r2
    .full:
    ret


; Feed one input character through the line discipline. Printable characters are
; echoed and buffered; backspace edits the line; Enter commits the whole line
; (with a trailing newline) to the ring and wakes any blocked reader; Ctrl+C
; interrupts (see below). Called by an input backend (e.g. the keyboard ISR).
; r1 - character (ASCII)
console_input_char:
    push r4
    mov r4, r1
    cmp r4, 10                   ; Enter
    je .enter
    cmp r4, 13                   ; treat CR as Enter
    je .enter
    cmp r4, 8                    ; Backspace
    je .backspace
    cmp r4, CON_INTR             ; Ctrl+C
    je .intr
    cmp r4, 32                   ; every other control code - a chord this line
    jul .ret                     ; discipline has no meaning for, and Tab, which
                                 ; the shell would only have split a token on -
                                 ; types nothing rather than a stray glyph

    mov r0, [console_linelen]    ; printable: buffer + echo
    cmp r0, CON_LINE_MAX
    juge .ret
    mov r1, console_line
    add r1, r0
    mov8 [r1], r4
    add r0, 1
    mov [console_linelen], r0
    mov r1, r4
    call console_putc
    call disp_present
    jmp .ret

    .backspace:
    mov r0, [console_linelen]
    cmp r0, 0
    je .ret
    sub r0, 1
    mov [console_linelen], r0
    mov r1, 8
    call console_putc
    call disp_present
    jmp .ret

    .enter:
    mov r1, 10                   ; echo the newline
    call console_putc
    call disp_present
    mov r0, 0                    ; copy the line into the ring
    .commit:
        mov r1, [console_linelen]
        cmp r0, r1
        juge .commitnl
        push r0
        mov r1, console_line
        add r1, r0
        mov8 r1, [r1]
        call console_ring_push
        pop r0
        add r0, 1
        jmp .commit
    .commitnl:
    mov r1, 10                   ; terminate the line with a newline
    call console_ring_push
    mov r0, 0
    mov [console_linelen], r0
    mov r1, [console_node]       ; wake anyone blocked reading the console
    call proc_wakeup
    jmp .ret

    ; Ctrl+C. Two things can be worth interrupting and which one it is depends on
    ; what is running, so both are handled: the half-typed line is always thrown
    ; away, and if this terminal has a foreground job then it is signalled as well.
    ; proc_tty_intr (proc/proc.cat) decides which processes those are; when it says
    ; none, the shell is sitting at a prompt and losing the line is the whole of it.
    ;
    ; The line goes rather than being committed because it was never a command: what
    ; you have typed so far is exactly what you have just said you do not want. "^C"
    ; is echoed the way a real terminal does, so the transcript shows where the
    ; interruption landed, and the newline puts the next prompt on its own line.
    ;
    ; When there was no job to signal, an *empty* line is committed. The reader is
    ; blocked halfway through a line it is never going to get, and a shell only
    ; prints a prompt when a read completes - so without this the interruption would
    ; leave the screen sitting there with no prompt on it until you typed a whole
    ; command. Nothing is needed in the signalled case: the shell is in wait(), and
    ; it prompts by itself the moment the job it is waiting for dies.
    .intr:
    mov r1, 94                   ; '^'
    call console_putc
    mov r1, 67                   ; 'C'
    call console_putc
    mov r1, 10
    call console_putc
    call disp_present
    mov r0, 0
    mov [console_linelen], r0
    mov r1, consolepath
    mov r2, [console_node]
    call proc_tty_intr
    cmp r0, 0
    jne .ret                     ; something was signalled: it prompts for itself
    mov r1, 10                   ; nothing was: hand the reader a blank line
    call console_ring_push
    mov r1, [console_node]
    call proc_wakeup

    .ret:
    pop r4
    ret


; /dev/console read(r1=node, r2=off, r3=buf, [sp]=len) -> r0 = bytes read, or
; CON_EAGAIN (-2) if no input is ready. The syscall layer turns -2 into a block.
; buf is a physical (kernel) address.
console_read:
    push r4                      ; buffer
    push r5                      ; capacity
    push r6                      ; count
    push r7                      ; len slot
    mov r4, r3
    mov r7, sp
    add r7, 20
    mov r5, [r7]

    mov r0, [console_rhead]
    mov r1, [console_rtail]
    cmp r0, r1
    je .empty                    ; nothing buffered -> ask the caller to block

    mov r6, 0
    .loop:
        cmp r6, r5
        juge .done
        mov r0, [console_rhead]
        mov r1, [console_rtail]
        cmp r0, r1
        je .done                 ; ring drained
        mov r1, console_ring
        add r1, r0
        mov8 r1, [r1]
        mov r2, r4
        add r2, r6
        mov8 [r2], r1
        add r0, 1
        cmp r0, CON_RING_SIZE
        jul .nowrap
        mov r0, 0
        .nowrap:
        mov [console_rhead], r0
        add r6, 1
        jmp .loop
    .done:
    mov r0, r6
    jmp .ret
    .empty:
    mov r0, -2                   ; CON_EAGAIN
    .ret:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Publish /dev/console. Call after devfs is mounted; records the node so readers
; can be woken on it. Returns r0 = node, or 0 on failure.
console_init:
    mov r1, consolename
    mov r2, NODE_CHARDEV
    mov r3, console_ops
    push 0                       ; fsdata (none)
    call devfs_add
    add sp, 4
    mov [console_node], r0
    ret


console_ops:
    d32 0                        ; OP_LOOKUP
    d32 console_read             ; OP_READ
    d32 console_write            ; OP_WRITE
    d32 0                        ; OP_CREATE
    d32 0                        ; OP_REMOVE
    d32 0                        ; OP_READDIR
    d32 0                        ; OP_TRUNCATE
    d32 0                        ; OP_STAT
    d32 0                        ; OP_SYNC
    d32 0                        ; OP_RENAME

consolename:
    dstr "console\0"
