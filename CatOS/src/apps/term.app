# An application entry, installed at /apps/term.app. The window managers' launcher
# reads every file in /apps and offers what it finds: name= is what it lists,
# exec= is the command line it runs (resolved against /bin, arguments allowed),
# desc= is the line shown beside the name. Anything else here is ignored.
name=Terminal
exec=term
desc=A shell in a window, with its own session
