; ==========================
;   CatOS userland syscall interface
; ==========================
; Shared by every user program. Defines the syscall numbers (which must match
; syscall.cat) and thin macros around the `syscall` instruction. User code runs
; in virtual mode, so `syscall` is the ONLY way it can reach the kernel - every
; privileged instruction (int, in, out, di, ei, iret, ...) faults here. A fault no
; longer crashes the machine: the kernel turns it into a signal (SIGSEGV for a bad
; access or privileged op, SIGILL for a bad opcode, SIGFPE for divide-by-zero) and,
; if the program has not installed a handler, terminates it with code 128+signal.
; See sys_signal / sys_kill below.
;
; Convention: r1 = syscall number, r2/r3 = arguments, r0 = result.

#define SYS_TEST, 0
#define SYS_YIELD, 1
#define SYS_EXIT, 2
#define SYS_GETPID, 3
#define SYS_WAIT, 4
#define SYS_PRINT, 5
#define SYS_SPAWN, 6
#define SYS_OPEN, 7
#define SYS_CLOSE, 8
#define SYS_READ, 9
#define SYS_WRITE, 10
#define SYS_SEEK, 11
#define SYS_READDIR, 12
#define SYS_CREATE, 13
#define SYS_SIGNAL, 14
#define SYS_KILL, 15
#define SYS_CHDIR, 16
#define SYS_GETCWD, 17
#define SYS_POWEROFF, 18
#define SYS_GACQUIRE, 19
#define SYS_GRELEASE, 20
#define SYS_GPRESENT, 24
#define SYS_MOUSE, 25
#define SYS_WCREATE, 26
#define SYS_WCOMMIT, 27
#define SYS_WLIST, 28
#define SYS_SBRK, 29
#define SYS_WREAD, 30
#define SYS_GKEY, 31
#define SYS_CONREAD, 32
#define SYS_WCONFIG, 33
#define SYS_WRESIZE, 34
#define SYS_KEYGRAB, 35
#define SYS_WPOST, 36
#define SYS_WINPUT, 37
#define SYS_PSLIST, 38
#define SYS_WKEYPOST, 39
#define SYS_WKEY, 40

; open() modes (bitfield) and seek() whence, matching the kernel VFS
#define O_READ, 1
#define O_WRITE, 2
#define O_RDWR, 3
#define O_CREATE, 4
#define O_APPEND, 8
#define O_TRUNC, 16
#define SEEK_SET, 0
#define SEEK_CUR, 1
#define SEEK_END, 2
; node types for create()
#define T_FILE, 1
#define T_DIR, 2

; Give up the CPU but stay runnable.
#macro sys_yield, 0
    mov r1, SYS_YIELD
    syscall
#endmacro

; Terminate with an exit code. $1 = code. Does not return.
#macro sys_exit, 1
    mov r2, $1
    mov r1, SYS_EXIT
    syscall
#endmacro

; Print a value (debug). $1 = value (register or immediate).
#macro sys_print, 1
    mov r2, $1
    mov r1, SYS_PRINT
    syscall
#endmacro

; getpid() -> the caller's own pid in r0.
#macro sys_getpid, 0
    mov r1, SYS_GETPID
    syscall
#endmacro

; Wait for a child pid to exit; its exit code lands in r0. $1 = pid.
#macro sys_wait, 1
    mov r2, $1
    mov r1, SYS_WAIT
    syscall
#endmacro

; Load and run a program by path, no arguments; its pid lands in r0 (-1 on fail).
; $1 = pointer to a null-terminated path.
#macro sys_spawn, 1
    mov r3, 0
    mov r2, $1
    mov r1, SYS_SPAWN
    syscall
#endmacro

; Spawn a program (no arguments) and wait for it; its exit code lands in r0.
; $1 = pointer to a null-terminated path.
#macro sys_spawnwait, 1
    mov r3, 0
    mov r2, $1
    mov r1, SYS_SPAWN
    syscall
    mov r2, r0
    mov r1, SYS_WAIT
    syscall
#endmacro

; Spawn a program with arguments; its pid lands in r0. $1 = path, $2 = argv
; (a null-terminated array of string pointers, in this program's address space).
#macro sys_spawn_argv, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_SPAWN
    syscall
#endmacro

; Spawn a program with arguments and wait for it; exit code lands in r0.
; $1 = path, $2 = argv.
#macro sys_spawnwait_argv, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_SPAWN
    syscall
    mov r2, r0
    mov r1, SYS_WAIT
    syscall
#endmacro

; ---- file I/O (return value in r0; r5-r7 survive a syscall, r1-r4 do not) ----

; open(path, mode) -> fd (or -1). $1 = path, $2 = O_* mode bits.
#macro sys_open, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_OPEN
    syscall
#endmacro

; close(fd). $1 = fd.
#macro sys_close, 1
    mov r2, $1
    mov r1, SYS_CLOSE
    syscall
#endmacro

; read(fd, buf, len) -> bytes read. $1 = fd, $2 = buffer, $3 = length.
#macro sys_read, 3
    mov r4, $3
    mov r3, $2
    mov r2, $1
    mov r1, SYS_READ
    syscall
#endmacro

; write(fd, buf, len) -> bytes written. $1 = fd, $2 = buffer, $3 = length.
#macro sys_write, 3
    mov r4, $3
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WRITE
    syscall
#endmacro

; seek(fd, offset, whence) -> new cursor. $1 = fd, $2 = offset, $3 = SEEK_*.
#macro sys_seek, 3
    mov r4, $3
    mov r3, $2
    mov r2, $1
    mov r1, SYS_SEEK
    syscall
#endmacro

; readdir(fd, buf, buflen) -> 1 entry / 0 end / -1. $1 = fd, $2 = name buffer.
#macro sys_readdir, 3
    mov r4, $3
    mov r3, $2
    mov r2, $1
    mov r1, SYS_READDIR
    syscall
#endmacro

; create(path, type) -> 0/-1. $1 = path, $2 = T_FILE or T_DIR.
#macro sys_create, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_CREATE
    syscall
#endmacro

; ---- signals ----
; Dispositions (passed as the handler argument to sys_signal):
#define SIG_DFL, 0              ; default action (terminate, or ignore for SIGUSR*)
#define SIG_IGN, 1              ; ignore the signal
; Signal numbers (keep in sync with the kernel's signal.cat):
#define SIGINT,  2
#define SIGILL,  4
#define SIGABRT, 6
#define SIGFPE,  8
#define SIGKILL, 9             ; cannot be caught or ignored
#define SIGUSR1, 10
#define SIGSEGV, 11
#define SIGUSR2, 12
#define SIGTERM, 15
#define NSIG_MAX, 15           ; highest signal the kernel accepts (its NSIG - 1)

; signal(signum, handler) -> previous disposition (or -1). $1 = signal number,
; $2 = a handler address, or SIG_DFL / SIG_IGN. A handler is a plain proc that
; takes the signal number in r1 and ends in `ret`; returning resumes wherever the
; program was interrupted. SIGKILL cannot be caught.
#macro sys_signal, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_SIGNAL
    syscall
#endmacro

; kill(pid, signum) -> 0/-1. Send a signal to a process. $1 = pid, $2 = signal.
#macro sys_kill, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_KILL
    syscall
#endmacro

; ---- the process table ----
; Everything a program can know about the other processes on the machine, which is
; deliberately not much and deliberately not privileged: a pid is not a capability
; here (kill takes any pid), so listing them grants nothing that guessing would
; not. It is what makes ps and pkill ordinary programs.
;
; One record per live process, in slot order:
;
;   +0  pid
;   +4  parent pid (0 for the processes the kernel starts at boot)
;   +8  state, one of PS_*
;   +12 program name, null-terminated within PS_NAME_MAX bytes
;
#define PS_NAME_MAX, 16          ; name field size, terminator included
#define PSREC_BYTES, 28          ; one record (must match the kernel's PSREC_BYTES)
#define PSREC_PID, 0
#define PSREC_PPID, 4
#define PSREC_STATE, 8
#define PSREC_NAME, 12
#define PS_MAX, 16               ; records the kernel can ever return (MAX_PROCS)
; process states, as reported in PSREC_STATE
#define PS_READY, 1              ; runnable, waiting for the CPU
#define PS_RUNNING, 2            ; on the CPU (the caller, when it is looking)
#define PS_BLOCKED, 3            ; waiting on something - console input, wait()
#define PS_ZOMBIE, 4             ; exited, still holding its slot until reaped
#define PS_EMBRYO, 5             ; being constructed

; pslist(dst, cap) -> the number of records written, or -1. $1 = buffer,
; $2 = its capacity in records. A capacity above PS_MAX is clamped, so
; PS_MAX * PSREC_BYTES is always enough room for everything.
#macro sys_pslist, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_PSLIST
    syscall
#endmacro

; ---- working directory ----
; chdir(path) -> 0/-1. Sets the process working directory. $1 = path (relative
; paths are resolved against the current directory). Fails if the path does not
; name an existing directory.
#macro sys_chdir, 1
    mov r2, $1
    mov r1, SYS_CHDIR
    syscall
#endmacro

; getcwd(buf, cap) -> 0/-1. Writes the working directory (an absolute, null-
; terminated path) into buf. $1 = buffer, $2 = capacity in bytes.
#macro sys_getcwd, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_GETCWD
    syscall
#endmacro

; ---- power ----
; poweroff() -> does not return. Powers the machine off via the kernel, which
; asks the hardware manager to shut down.
#macro sys_poweroff, 0
    mov r1, SYS_POWEROFF
    syscall
#endmacro

; ---- graphical desktop ----
; The compositor is an ordinary userland program. It asks the kernel for a chunk
; of extra memory (sbrk), draws its framebuffer there itself, and points the
; display hardware straight at it (gacquire). The kernel only switches the video
; mode, flushes, and relays pixels between processes (the CPU has no shared
; memory, so a client's window pixels reach the compositor through wread).
;
; The screen is 512x384, too small for floating windows, so the desktop shows one
; full-screen page at a time with a tab bar along the bottom: page 0 is the text
; console (drawn from conread) and every surface a program creates becomes another
; page. From a client's point of view none of that matters - it creates a surface
; and commits pixels to it, exactly as it would for a window.

; sbrk(bytes) -> base pointer of the new region, or -1. Grow the caller's memory
; segment by at least $1 bytes (rounded up to a page). The returned pointer is
; valid for [base, base + bytes). $1 = byte count.
#macro sys_sbrk, 1
    mov r2, $1
    mov r1, SYS_SBRK
    syscall
#endmacro

; gacquire(fb, textgeom) -> (width << 16) | height, or -1. Take over the screen:
; the display scans out the caller's own buffer $1, which must hold a whole frame.
; $2 is the console geometry the window manager wants while it owns the screen,
; packed as (columns << 16) | rows, or 0 to leave the console's geometry alone -
; a manager that never shows the console passes 0. The screen size comes back in
; r0; nothing hardcodes it.
#macro sys_gacquire, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_GACQUIRE
    syscall
#endmacro

; ---- key events -------------------------------------------------------------
; Everything that reads the keyboard without going through the console - a window
; manager (gkey) and a windowed program (wkey) - gets one word per thing the
; keyboard did. It carries both ways of looking at a keystroke, because programs
; genuinely need both and neither can be derived from the other out here:
;
;   bits  0..15   KEV_CODE_MASK   the keycode, exactly as the keyboard reported it
;   bits 16..23   KEV_CHAR_*      the character it produces, or 0 if none
;   bits 24..27   KEV_MOD_*       the modifiers held at that moment (KMOD_*)
;   bit  28       KEV_MODKEY      this key IS a modifier (shift, control, alt, super)
;   bit  31       KEV_UP          set on a release, clear on a press
;
; A game wants the *key*: the raw code, and releases as well as presses, so it can
; keep its own picture of what is held down right now. A program being typed into
; wants the *character* - and SHIFT+2 is not a keycode, it is the keyboard layout's
; answer to a keycode plus a modifier. Only the keyboard driver knows the layout, so
; it answers that once and every program is spared its own copy of one.
;
; The keycode sits alone in the low bits, so an unmodified press is numerically equal
; to the bare keycode: code that only cares about those can still compare against
; one, and a release or a modified press compares unequal to every keycode rather
; than being mistaken for a different one.
;
; KEV_MODKEY exists so that a program which wants to skip "somebody pressed shift"
; does not have to know what keycode shift is - that stays with the keyboard driver,
; along with the layout. Nothing out here should ever name a modifier keycode.
;
; Keep these in sync with the KEV_* / KMOD_* list in the kernel's gfx/display.cat.
#define KEV_CODE_MASK, 0xFFFF
#define KEV_CHAR_SHIFT, 16
#define KEV_CHAR_MASK, 0xFF
#define KEV_MOD_SHIFT, 24
#define KEV_MOD_MASK, 0xF
#define KEV_MODKEY, 0x10000000
#define KEV_UP, 0x80000000
#define KMOD_SHIFT, 1
#define KMOD_CTRL, 2
#define KMOD_ALT, 4
#define KMOD_SUPER, 8

; Reduce a key event held in a register to one of its fields, in place, so reading
; one is a line rather than three. $1 = a register holding an event.
;   kev_code r4    -> the keycode alone
;   kev_char r4    -> the character it types, or 0
;   kev_mods r4    -> the KMOD_* mask
; For the direction, test the release bit yourself: `and r0, KEV_UP`.
#macro kev_code, 1
    and $1, KEV_CODE_MASK
#endmacro

#macro kev_char, 1
    shr $1, KEV_CHAR_SHIFT
    and $1, KEV_CHAR_MASK
#endmacro

#macro kev_mods, 1
    shr $1, KEV_MOD_SHIFT
    and $1, KEV_MOD_MASK
#endmacro

; keygrab(keycode, on) -> 0/-1. While you hold the screen, claim a keycode so its
; events are delivered to you through gkey instead of to the console line discipline
; (or give it back with on = 0). This is how a window manager gets its shortcuts; the
; kernel never interprets a keycode, it only compares. $1 = keycode, $2 = 1/0.
; A grab covers that key's release and its shifted form too - whether SHIFT+LEFT
; means something other than LEFT is your decision, made from the modifier bits in
; the event, not the kernel's.
; A keycode of -1 grabs *every* key, which is what a full-screen program that wants
; the keyboard itself asks for: the line discipline echoes, buffers whole lines and
; needs Enter before it hands anything over, so a program that wants raw keys has to
; take them all.
#macro sys_keygrab, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_KEYGRAB
    syscall
#endmacro

; grelease(). Hand the screen back to the text console.
#macro sys_grelease, 0
    mov r1, SYS_GRELEASE
    syscall
#endmacro

; gpresent() -> 0/-1. Flush the framebuffer to the display. Compositor only.
#macro sys_gpresent, 0
    mov r1, SYS_GPRESENT
    syscall
#endmacro

; mouse(dst) -> 0/-1. Write [x, y, buttons] (three words) into dst. Button bit 0
; is the left button. $1 = pointer to a 12-byte buffer.
#macro sys_mouse, 1
    mov r2, $1
    mov r1, SYS_MOUSE
    syscall
#endmacro

; wcreate(w, h) -> surface id, or -1. Create a window surface. $1/$2 are the size
; you would *like*, bounded by the screen; the kernel grants it as-is, but a window
; manager may hand you something else at any time, so read your real size back with
; wconfig rather than assuming you got what you asked for.
#macro sys_wcreate, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WCREATE
    syscall
#endmacro

; wcommit(sid, src) -> 0/-1. Upload a w*h*4 pixel image into surface sid, which you
; must own - a surface id is a slot index, not a capability, so the kernel checks
; the owning pid on every write. $1 = surface id, $2 = pointer to the pixels.
#macro sys_wcommit, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WCOMMIT
    syscall
#endmacro

; wlist(dst, cap) -> count, or -1. Write [sid, w, h, reqw, reqh, seq, pid] per live
; surface, up to cap records: what exists, the size it currently has, the size its
; program asked for, a commit counter that changes whenever its pixels do (so an
; unchanged window need not be fetched at all), and the pid of the program that owns
; it. The pid is what a close button is built out of - there is no "close a window"
; syscall, so a manager closes one by signalling its program, the same way pkill
; does. $1 = buffer, $2 = capacity in records. Window manager only - the kernel
; rejects callers that do not hold the screen.
#macro sys_wlist, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WLIST
    syscall
#endmacro

; wread(sid, dst) -> 0/-1. Copy surface sid's committed w*h*4 pixels into the
; caller's buffer $2 so the compositor can composite them itself. $1 = surface id,
; $2 = destination buffer. Compositor only - the kernel rejects callers that do not
; hold the screen, so one program cannot read another's window.
#macro sys_wread, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WREAD
    syscall
#endmacro

; wconfig(sid, dst) -> 0/-1. Read back what your surface actually is: three words
; [granted width, granted height, config counter] into $2. The counter changes only
; when the geometry does, so poll it and redraw to fit when it moves - that is the
; whole client side of resizing. $1 = surface id, $2 = a 12-byte buffer.
#macro sys_wconfig, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WCONFIG
    syscall
#endmacro

; wpost(sid, src) -> 0/-1. Hand a surface the pointer in its own coordinates: three
; words [x, y, buttons] at $2, or (-1, -1, 0) for "not over this window". The window
; manager is the only thing that knows where a window landed, so it does the
; hit-testing. $1 = surface id, $2 = a 12-byte buffer. Window manager only.
#macro sys_wpost, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WPOST
    syscall
#endmacro

; winput(sid, dst) -> 0/-1. Read the pointer over your own window: [x, y, buttons]
; into $2, with x and y relative to your top-left corner, or -1 when the pointer is
; elsewhere. This is how a GUI program gets clicks - SYS_MOUSE is in screen
; coordinates and you do not know where you are. $1 = surface id, $2 = 12 bytes.
#macro sys_winput, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WINPUT
    syscall
#endmacro

; wkeypost(sid, event) -> 0/-1. Hand a surface a key. A keystroke carries no
; coordinates, so unlike the pointer there is nothing to route it by except focus,
; and focus is the window manager's decision - it takes the keyboard with
; keygrab(-1) and posts each key to whichever window it considers focused. Pass the
; event on whole: what a window makes of a release, or of a modifier, is its
; business, not yours. $1 = surface id, $2 = the event from gkey. Window manager only.
#macro sys_wkeypost, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WKEYPOST
    syscall
#endmacro

; wkey(sid) -> the next key event posted to your window, or -1 if there is none.
; This is how a windowed program reads the keyboard: reading the console instead
; would get you echoed, line-buffered text that the shell is already waiting for.
; Take it apart with kev_code / kev_char / kev_mods above - typing wants the
; character, a shortcut or a held-down control wants the keycode and the release
; bit. $1 = surface id.
#macro sys_wkey, 1
    mov r2, $1
    mov r1, SYS_WKEY
    syscall
#endmacro

; wresize(sid, size) -> 0/-1. Grant a surface a size, packed as
; (width << 16) | height. Granting the size it already has does nothing, so a
; window manager can call this every frame from its layout. $1 = surface id,
; $2 = packed size. Window manager only.
#macro sys_wresize, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_WRESIZE
    syscall
#endmacro

; gkey() -> the next queued key event, or -1 if none. The keyboard ISR routes every
; key you grabbed here instead of to the console line discipline, so you see them and
; the shell never does. Compositor only; see the key event layout above.
#macro sys_gkey, 0
    mov r1, SYS_GKEY
    syscall
#endmacro

; conread(dst, cap) -> bytes written, or -1. Snapshot the text console into dst as
; a 20-byte header (columns, rows, cursor column, cursor row, change counter)
; followed by columns*rows characters, row-major. Lets a graphical program draw the
; console itself - which is how the desktop shows the shell as a page - and the
; counter lets it skip that work when nothing has been typed or printed.
; $1 = buffer, $2 = its capacity in bytes.
#macro sys_conread, 2
    mov r3, $2
    mov r2, $1
    mov r1, SYS_CONREAD
    syscall
#endmacro
