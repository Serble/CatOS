; ==========================
;   Shared output formatting
; ==========================
; Line-buffered text output for the small command-line programs, so a row of
; columns costs one write instead of one per field.
;
; Include this AFTER the program's main body, never before it: a program is loaded
; at user vaddr 0 and starts executing at its first instruction, so whatever the
; first #include emits would run instead of main.
;
; Clobbers r0-r3 like any other procedure and preserves r4-r7.

#define FMT_LINEMAX, 128
#define FMT_DECBUF, 13                   ; 10 digits and a terminator, with room


; emit_char(r1 = character) - append one byte to the row, dropping it if the row
; is already full rather than running off the end of the buffer.
emit_char:
    push r4                              ; write cursor
    mov r4, [fmt_cur]
    mov r0, r4
    sub r0, fmt_linebuf
    cmp r0, FMT_LINEMAX - 1
    juge .full
    mov8 [r4], r1
    add r4, 1
    mov [fmt_cur], r4
    .full:
    pop r4
    ret


; emit_str(r1 = null-terminated string) - append it.
emit_str:
    push r4                              ; read cursor
    mov r4, r1
    .loop:
        mov8 r0, [r4]
        cmp r0, 0
        je .done
        mov r1, r0
        call emit_char
        add r4, 1
        jmp .loop
    .done:
    pop r4
    ret


; emit_dec(r1 = value, r2 = width) - append the value as decimal, right-aligned in
; a space-padded field of r2 columns. A value too wide for the field just runs
; over, which keeps the number readable at the cost of the alignment.
;
; Digits come out least-significant-first, so they are generated backwards into
; fmt_decbuf, whose final byte is left as the terminator emit_str stops on.
emit_dec:
    push r4                              ; digit cursor
    push r5                              ; digits produced
    push r6                              ; field width
    mov r6, r2
    mov r4, fmt_decbuf
    add r4, FMT_DECBUF - 1
    mov r5, 0
    .digits:
        mov r2, 10
        udiv r1, r2                      ; r1 = quotient, r2 = remainder
        add r2, 48                       ; '0'
        sub r4, 1
        mov8 [r4], r2
        add r5, 1
        cmp r1, 0
        jne .digits
    .pad:
        cmp r5, r6
        juge .write
        mov r1, 32                       ; ' '
        call emit_char
        add r5, 1
        jmp .pad
    .write:
    mov r1, r4
    call emit_str
    pop r6
    pop r5
    pop r4
    ret


; flush() - write the assembled row to stdout and start a new one.
flush:
    push r4                              ; length (also sys_write's third argument)
    mov r4, [fmt_cur]
    sub r4, fmt_linebuf
    cmp r4, 0
    je .empty
    sys_write 1, fmt_linebuf, r4
    .empty:
    mov r0, fmt_linebuf
    mov [fmt_cur], r0
    pop r4
    ret


; parse_dec(r1 = string) -> r0 = value, or -1 if it is not all digits.
; Used for the numeric arguments the partitioning tools take.
parse_dec:
    push r4                              ; cursor
    push r5                              ; accumulated value
    push r6                              ; digits seen
    mov r4, r1
    mov r5, 0
    mov r6, 0
    .loop:
        mov8 r0, [r4]
        cmp r0, 0
        je .done
        cmp r0, 48
        jul .bad
        cmp r0, 57
        jug .bad
        sub r0, 48
        mov r1, r5
        mov r2, 10
        umul r1, r2                      ; r1 = value * 10
        add r1, r0
        mov r5, r1
        add r6, 1
        add r4, 1
        jmp .loop
    .done:
    cmp r6, 0
    je .bad                              ; an empty string is not a number
    mov r0, r5
    jmp .out
    .bad:
    mov r0, -1
    .out:
    pop r6
    pop r5
    pop r4
    ret


fmt_cur:
    d32 fmt_linebuf
fmt_decbuf:
    res8 FMT_DECBUF
fmt_linebuf:
    res8 FMT_LINEMAX
