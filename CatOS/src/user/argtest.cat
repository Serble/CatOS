; Proves argv passing: the kernel starts a process with r1 = argc and r2 = argv
; (a pointer, in this process's own address space, to an array of string
; pointers). Print argc, then the first character of argv[1].
#include "lib/sys.cat"

    mov r5, r1                    ; argc   (r5-r7 survive syscalls)
    mov r6, r2                    ; argv

    sys_print r5                  ; expect argc = 3 (argtest, B, CC)

    mov r0, r6                    ; argv[1] = *(argv + 4)
    add r0, 4
    mov r0, [r0]                  ; -> address of the "B" string
    mov8 r0, [r0]                 ; first byte
    sys_print r0                  ; expect 'B' = 0x42 = 66

    sys_exit 0
