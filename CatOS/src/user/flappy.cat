; flappy - a flappy-bird clone. An ordinary userland program with a window.
;
;   +------------------------------+
;   | BEST 12          ###   ###   |
;   |                  ###   ###   |
;   |          @>            ###   |
;   |                  ###         |
;   |   3              ###   ###   |
;   |##############################|
;   +------------------------------+
;
; Like every other client here it knows nothing about which window manager is
; running: under desktop.cat it is a page, under tile.cat it is a tile that gets
; resized to fit, and it behaves the same either way because it only ever asks the
; kernel the three questions a client may ask about itself - wconfig (how big am I
; now?), winput (where is the pointer on me?) and wkey (what has been typed at me?).
;
;
; -- Why the world is measured in units, not pixels ---------------------------
;
; A game has a *feel*, and the feel is the relationship between how far the bird
; falls, how wide the gap is and how fast the pipes come. If those were pixel
; constants the game would be a different game in every window: playable full-screen
; under desktop, impossible in a quarter-screen tile under tile.cat. So the whole
; simulation runs in world units - the world is WORLD_H units tall, always, whatever
; the window is - and the only thing the window size decides is the scale factor
; every coordinate is multiplied by on its way to the framebuffer (u2px). A resize
; therefore zooms the picture and changes nothing about the difficulty.
;
; The scale is uniform (both axes use winh), so nothing is stretched. That makes the
; *world width* a consequence of the window's aspect ratio rather than a constant:
; a wide window simply sees further ahead. Pipes are spawned relative to the right
; edge, so that is all it means.
;
;
; -- Why time is counted in fixed ticks ---------------------------------------
;
; The loop is `yield` in a circle, so it runs at whatever rate the scheduler feels
; like - which is neither constant nor knowable. Integrating gravity against a
; variable dt would make the physics depend on how busy the machine is. So real time
; (uptms) is only used to decide *how many* TICK_MS steps are owed, and each step is
; identical: one constant added to the velocity, the velocity added to the position.
; The backlog is capped at MAX_TICKS, because a program that was descheduled for a
; second should drop that second rather than teleport the bird through a pipe.
;
; Positions and velocities are held in 1/64ths of a unit so that a step's worth of
; movement is an integer with something left over - a whole unit per tick would be
; far too coarse, and this machine has no floating point.
;
;
; -- Why the frame is only committed when something moved ---------------------
;
; A window manager pays for every commit (it has to fetch the pixels back out with
; wread and recomposite), so an idle window should cost it nothing. `step` reports
; whether anything actually moved, and the title screen and a settled game-over
; screen move nothing at all: they commit one frame and then go quiet.
;
;
; -- The best score -----------------------------------------------------------
;
; Kept in /home/flappy.score as plain decimal text, so `cat /home/flappy.score`
; shows it and deleting the file resets it. It is read once at startup and written
; only when it is beaten, which is the only moment it can have changed - a game
; loop has no business writing to a disk 40 times a second. A missing or unreadable
; file simply means "no best yet"; there is nothing here worth failing to start over.
;
;   $ flappy &
;   $ bg flappy
#include "lib/sys.cat"

#define WANT_W, 512                  ; ask for the whole screen: a window manager
#define WANT_H, 384                  ; that has an opinion will cut us down to it
#define MAX_BYTES, 786432            ; 512 * 384 * 4 - any size we could be granted

#define GW, 8                        ; the console font is 8x16, 1bpp
#define GH, 16
#define FONT_GLYPHS, 129

; ---- the world, in units ----
; WORLD_H is the whole height of the window, whatever the window is. Everything
; below is in the same currency, so the numbers here are the game's design and
; nothing about them depends on the display.
#define WORLD_H, 1000
#define GROUND_Y, 910                ; top of the ground strip
#define BIRD_X, 220                  ; the bird never moves horizontally
#define BIRD_R, 32                   ; half its width and height
#define PIPE_W, 130
#define PIPE_CAP, 34                 ; the lip on the end of a pipe
#define GAP_HALF, 165                ; half the hole a bird has to fly through
#define GAP_MIN, 230                 ; where the centre of that hole may sit
#define GAP_SPAN, 450
#define SPACING, 800                 ; distance between one pipe and the next
#define NPIPES, 3                    ; enough to cover the widest sensible window
#define FIRST_PIPE, 300              ; the first one starts this far past the edge

; ---- the same world in 1/64ths, for the parts that move ----
#define FIX, 64
#define CEIL_F, 2048                 ; BIRD_R * FIX: the bird may not leave the top
#define REST_F, 56192                ; (GROUND_Y - BIRD_R) * FIX: where a corpse lands
#define BIRD_X_F, 14080              ; BIRD_X * FIX
#define PIPE_W_F, 8320               ; PIPE_W * FIX
#define SPACING_F, 51200             ; SPACING * FIX

; ---- one tick of simulation ----
; TICK_MS is the step; the three constants below are the design values (2600 u/s^2
; of gravity, an 820 u/s flap, 420 u/s of scrolling) already multiplied out into
; 1/64 units per tick, so the step itself is three additions.
#define TICK_MS, 25
#define GRAV_T, 104
#define FLAP_T, -1312
#define MAXV_T, 2400                 ; terminal velocity, so a long fall stays fair
#define PIPE_T, 672
#define MAX_TICKS, 4                 ; the most catch-up one iteration will do

; ---- states ----
#define ST_READY, 0                  ; waiting for the first flap
#define ST_PLAY, 1
#define ST_DEAD, 2
#define RETRY_MS, 400                ; ignore input this long after dying

; Raylib keycodes. Only the keys that produce no character need naming - space
; arrives as the character 32, which is what the event's character field is for.
#define KEY_ESCAPE, 256
#define KEY_ENTER, 257
#define KEY_UP, 265
#define KEY_KPENTER, 335
#define CH_SPACE, 32

#define SKY, 0x004EC0CA
#define PIPE_BODY, 0x0074BF2E
#define PIPE_EDGE, 0x00558E22
#define PIPE_LIT, 0x0096D65A
#define GROUND_DIRT, 0x00DED895
#define GROUND_GRASS, 0x0074BF2E
#define GROUND_LINE, 0x00558E22
#define BIRD_BODY, 0x00F7D51D
#define BIRD_WING, 0x00E0A310
#define BIRD_BEAK, 0x00F3792B
#define EYE_WHITE, 0x00FFFFFF
#define EYE_PUPIL, 0x00202020
#define TEXT_COLOUR, 0x00FFFFFF
#define TEXT_SHADOW, 0x00285A62
#define GOLD_COLOUR, 0x00FFD65A
#define PANEL_BG, 0x00123B45
#define PANEL_EDGE, 0x00FFFFFF


main:
    sys_sbrk MAX_BYTES               ; the window buffer, at the biggest size we
    cmp r0, -1                       ; could ever be granted, so a resize never
    je fail                          ; has to allocate anything
    mov [winbuf], r0

    call seed_rng
    call load_best                   ; before the window, so a slow disk is not a
                                     ; blank window
    sys_wcreate WANT_W, WANT_H
    cmp r0, -1
    je fail
    mov [sid], r0

    call relayout                    ; a world width for the size we asked for
    call reset_game
    uptms
    mov [lastms], r0

    .loop:
        call resync                  ; adopt whatever size we have been granted
        call handle_keys             ; r0 = 1 when ESC was pressed
        cmp r0, 1
        je .quit
        call handle_click
        call run_ticks
        mov r0, [dirty]
        cmp r0, 0
        je .idle
        call redraw
        mov r0, 0
        mov [dirty], r0
        sys_wcommit [sid], [winbuf]
        .idle:
        sys_yield
        jmp .loop

    .quit:
        sys_exit 0

fail:
    sys_exit 1


; ==========================
;   Size
; ==========================

; Pick up the size the window manager has granted us. Only the config counter
; moving means anything changed, so this is a compare in the common case.
resync:
    sys_wconfig [sid], cfgbuf
    cmp r0, -1
    je .done                         ; surface gone; the next commit will fail too
    mov r0, cfgbuf
    add r0, 8
    mov r0, [r0]                     ; config counter
    mov r1, [lastcfg]
    cmp r0, r1
    je .done
    mov [lastcfg], r0
    mov r0, [cfgbuf]
    mov [winw], r0
    mov r0, cfgbuf
    add r0, 4
    mov r0, [r0]
    mov [winh], r0
    call relayout
    mov r0, 1                        ; redraw at the new size
    mov [dirty], r0
    .done:
    ret


; How wide the world is, in units. The scale is uniform, so this falls out of the
; aspect ratio: a wide window sees further ahead rather than seeing a squashed
; game. Nothing else in the simulation depends on the window at all.
relayout:
    mov r0, [winh]
    cmp r0, 1
    jig .measure
    mov [worldw], WORLD_H            ; degenerate size: pick something sane rather
    ret                              ; than divide by it
    .measure:
    mov r0, [winw]
    umul r0, WORLD_H
    mov r1, [winh]
    udiv r0, r1
    mov r1, BIRD_X + 400             ; a world narrower than this would spawn pipes
    cmp r0, r1                       ; on top of the bird
    juge .ok
    mov r0, r1
    .ok:
    mov [worldw], r0
    ret


; units -> pixels, the only place the window size touches a coordinate.
; r1 = units (may be negative), r0 = pixels.
u2px:
    mov r0, r1
    mov r1, [winh]
    imul r0, r1
    mov r1, WORLD_H
    idiv r0, r1
    ret


; ==========================
;   The game
; ==========================

; Back to the title screen, with a fresh set of pipes queued off the right edge.
reset_game:
    push r4                          ; pipe index
    push r5                          ; that pipe's x
    mov [state], ST_READY
    mov r0, 0
    mov [score], r0
    mov [newbest], r0
    mov [vel], r0
    mov [yf], 28800                  ; 450 units: halfway up
    mov r5, [worldw]
    add r5, FIRST_PIPE
    umul r5, FIX
    mov r4, 0
    .each:
        cmp r4, NPIPES
        juge .done
        mov r0, r4
        umul r0, 4
        add r0, pipex
        mov [r0], r5
        call new_gap                 ; r0 = a fresh gap centre
        mov r1, r4
        umul r1, 4
        add r1, pipegap
        mov [r1], r0
        mov r1, r4
        umul r1, 4
        add r1, pipescored
        mov r0, 0
        mov [r1], r0
        add r5, SPACING_F
        add r4, 1
        jmp .each
    .done:
    mov [dirty], 1
    pop r5
    pop r4
    ret


; Run whatever whole ticks real time owes us. Time only ever decides how many
; steps to take - never how big one is - so the physics are identical on a busy
; machine and an idle one.
run_ticks:
    push r4                          ; ticks owed
    uptms
    mov r1, [lastms]
    sub r0, r1
    cmp r0, TICK_MS
    jul .done                        ; not a whole tick yet
    mov r1, TICK_MS
    udiv r0, r1                      ; r0 = ticks, r1 = the leftover we keep owing
    mov r4, r0
    cmp r4, MAX_TICKS
    jule .advance
    mov r4, MAX_TICKS                ; a long descheduling is dropped, not replayed:
    uptms                            ; catching up through a pipe is worse than a
    mov [lastms], r0                 ; visible stutter
    jmp .run
    .advance:
    mov r0, r4
    umul r0, TICK_MS
    mov r1, [lastms]
    add r0, r1
    mov [lastms], r0
    .run:
    .each:
        cmp r4, 0
        jule .done
        call step
        cmp r0, 0
        je .quiet
        mov [dirty], 1
        .quiet:
        sub r4, 1
        jmp .each
    .done:
    pop r4
    ret


; One tick. r0 = 1 if the picture changed, which is what decides whether the frame
; is worth committing.
step:
    mov r0, [state]
    cmp r0, ST_PLAY
    je .play
    cmp r0, ST_DEAD
    je .dead
    mov r0, 0                        ; the title screen is still: nothing to commit
    ret

    .play:
    call bird_step
    call pipes_step
    call collide
    cmp r0, 0
    je .moved
    call die
    .moved:
    mov r0, 1
    ret

    .dead:
    mov r0, [yf]                     ; the bird finishes falling, then everything
    cmp r0, REST_F                   ; stops and the window goes quiet again
    jige .still
    call bird_step
    mov r0, [yf]
    cmp r0, REST_F
    jil .fell
    mov [yf], REST_F
    mov r0, 0
    mov [vel], r0
    .fell:
    mov r0, 1
    ret
    .still:
    mov r0, 0
    ret


; Gravity, then movement. The ceiling is a wall rather than an exit, so a panicked
; flapper cannot climb out of the world and coast over everything.
bird_step:
    mov r0, [vel]
    add r0, GRAV_T
    cmp r0, MAXV_T
    jile .vok
    mov r0, MAXV_T
    .vok:
    mov [vel], r0
    mov r1, [yf]
    add r1, r0
    cmp r1, CEIL_F
    jige .yok
    mov r1, CEIL_F
    mov r0, 0
    mov [vel], r0
    .yok:
    mov [yf], r1
    ret


; Scroll the pipes, recycle the one that has left, and count the ones we have got
; past. A recycled pipe is placed behind the rightmost one rather than at a fixed
; distance from the edge, so the spacing stays even at any window width.
pipes_step:
    push r4                          ; pipe index
    push r5                          ; this pipe's x
    push r6                          ; the rightmost x we know of
    push r7                          ; address of the field being updated
    call rightmost_x
    mov r6, r0
    mov r4, 0
    .each:
        cmp r4, NPIPES
        juge .done
        mov r7, r4
        umul r7, 4
        add r7, pipex
        mov r5, [r7]
        sub r5, PIPE_T
        mov r0, r5                   ; wholly off the left edge? send it round again
        add r0, PIPE_W_F
        cmp r0, 0
        jige .keep
        mov r5, r6
        add r5, SPACING_F
        mov r6, r5
        call new_gap
        mov r1, r4
        umul r1, 4
        add r1, pipegap
        mov [r1], r0
        mov r1, r4
        umul r1, 4
        add r1, pipescored
        mov r0, 0
        mov [r1], r0
        .keep:
        mov [r7], r5
        mov r7, r4                   ; scoring: the moment its trailing edge is
        umul r7, 4                   ; behind the bird
        add r7, pipescored
        mov r0, [r7]
        cmp r0, 0
        jne .next
        mov r0, r5
        add r0, PIPE_W_F
        cmp r0, BIRD_X_F
        jige .next
        mov r0, 1
        mov [r7], r0
        mov r0, [score]
        add r0, 1
        mov [score], r0
        .next:
        add r4, 1
        jmp .each
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; The x of the pipe that is furthest to the right -> r0.
rightmost_x:
    push r4                          ; index
    push r5                          ; best so far
    mov r5, [pipex]
    mov r4, 1
    .each:
        cmp r4, NPIPES
        juge .done
        mov r0, r4
        umul r0, 4
        add r0, pipex
        mov r0, [r0]
        cmp r0, r5
        jile .next
        mov r5, r0
        .next:
        add r4, 1
        jmp .each
    .done:
    mov r0, r5
    pop r5
    pop r4
    ret


; Has the bird hit anything? r0 = 1 if so. Everything here is a rectangle overlap
; in world units - which is the point of world units: the answer cannot depend on
; what size the window happens to be.
collide:
    push r4                          ; index
    push r5                          ; bird top
    push r6                          ; bird bottom
    push r7                          ; this pipe's x, in whole units
    mov r5, [yf]
    shr r5, 6                        ; yf is never negative: the ceiling clamps it
    mov r6, r5
    add r6, BIRD_R
    sub r5, BIRD_R
    cmp r6, GROUND_Y
    jige .hit
    mov r4, 0
    .each:
        cmp r4, NPIPES
        juge .clear
        mov r0, r4
        umul r0, 4
        add r0, pipex
        mov r1, [r0]
        call u_of_fix                ; floor division: a pipe's x goes negative
        mov r7, r0
        mov r0, BIRD_X + BIRD_R      ; no horizontal overlap, no collision
        cmp r0, r7
        jile .next
        mov r0, r7
        add r0, PIPE_W
        mov r1, BIRD_X - BIRD_R
        cmp r1, r0
        jige .next
        mov r0, r4                   ; overlapping: only the gap is survivable
        umul r0, 4
        add r0, pipegap
        mov r0, [r0]
        mov r1, r0
        sub r1, GAP_HALF
        cmp r5, r1
        jil .hit
        add r0, GAP_HALF
        cmp r6, r0
        jig .hit
        .next:
        add r4, 1
        jmp .each
    .clear:
    mov r0, 0
    jmp .done
    .hit:
    mov r0, 1
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; 1/64ths -> whole units, rounding towards negative infinity so that a pipe leaving
; the left edge keeps moving smoothly rather than sticking at -0. r1 in, r0 out.
u_of_fix:
    mov r0, r1
    mov r1, FIX
    idiv r0, r1
    ret


; The bird has hit something. This is the one moment the best score can change, so
; it is the one moment the file is written.
die:
    mov [state], ST_DEAD
    uptms
    mov [deadms], r0
    mov r0, [score]
    mov r1, [best]
    cmp r0, r1
    jule .done
    mov [best], r0
    mov [newbest], 1
    call save_best
    .done:
    ret


; What space and a click both mean, which depends entirely on what is happening:
; start, flap, or play again.
flap:
    mov r0, [state]
    cmp r0, ST_READY
    je .start
    cmp r0, ST_PLAY
    je .go
    cmp r0, ST_DEAD
    je .retry
    ret
    .start:
    mov [state], ST_PLAY
    uptms                            ; the clock starts now: whatever time passed
    mov [lastms], r0                 ; on the title screen is not a backlog of ticks
    .go:
    mov [vel], FLAP_T
    mov [dirty], 1
    ret
    .retry:
    uptms                            ; a moment's deafness, so that mashing the key
    mov r1, [deadms]                 ; you died with does not skip the score
    sub r0, r1
    cmp r0, RETRY_MS
    jul .done
    call reset_game
    .done:
    ret


; ==========================
;   Input
; ==========================

; Drain the keys the window manager has posted to us. r0 = 1 if ESC was pressed.
; Releases and modifiers are dropped: this is a game of presses.
handle_keys:
    push r4                          ; the field being examined
    push r5                          ; quit requested
    mov r5, 0
    .drain:
        sys_wkey [sid]
        cmp r0, -1
        je .done                     ; nothing waiting for us
        mov r4, r0
        and r4, KEV_UP
        cmp r4, 0
        jne .drain
        mov r4, r0
        and r4, KEV_MODKEY
        cmp r4, 0
        jne .drain
        mov r4, r0                   ; space is a character, not a named key: the
        kev_char r4                  ; keyboard driver owns the layout, not us
        cmp r4, CH_SPACE
        je .flap
        mov r4, r0
        kev_code r4
        cmp r4, KEY_ESCAPE
        je .quit
        cmp r4, KEY_UP
        je .flap
        cmp r4, KEY_ENTER
        je .flap
        cmp r4, KEY_KPENTER
        je .flap
        jmp .drain
        .flap:
        call flap
        jmp .drain
        .quit:
        mov r5, 1
        jmp .drain
    .done:
    mov r0, r5
    pop r5
    pop r4
    ret


; A click anywhere on the window is a flap. The coordinates are already ours, so
; there is no hit testing to do - the whole window is the button.
handle_click:
    push r4                          ; this frame's buttons
    sys_winput [sid], inbuf
    cmp r0, -1
    je .done                         ; the pointer is somewhere else entirely
    mov r0, inbuf
    add r0, 8
    mov r4, [r0]
    and r4, 1
    cmp r4, 0
    je .store
    mov r0, [prevbtn]                ; only the press edge counts, so holding the
    cmp r0, 0                        ; button down is one flap
    jne .store
    call flap
    .store:
    mov [prevbtn], r4
    .done:
    pop r4
    ret


; ==========================
;   The best score, on disk
; ==========================

; Read /home/flappy.score. Anything unreadable means "no best yet" - there is
; nothing here worth refusing to start a game over.
load_best:
    push r4                          ; fd
    push r5                          ; bytes read
    sys_open bestpath, O_READ
    cmp r0, -1
    je .done
    mov r4, r0
    sys_read r4, numbuf, 15
    mov r5, r0
    sys_close r4
    cmp r5, 0
    jile .done
    mov r1, numbuf
    mov r2, r5
    call parse_uint
    mov [best], r0
    .done:
    pop r5
    pop r4
    ret


; Write it back as decimal text with a newline, so `cat` shows it and an editor
; could set it. A failure is silently ignored: losing a high score is not a reason
; to interrupt a game.
save_best:
    push r4                          ; fd
    push r5                          ; bytes to write
    mov r1, [best]
    mov r2, numbuf
    call utoa
    mov r5, r0
    mov r0, numbuf
    add r0, r5
    mov8 [r0], 10                    ; '\n'
    add r5, 1
    sys_open bestpath, O_WRITE + O_CREATE + O_TRUNC
    cmp r0, -1
    je .done
    mov r4, r0
    sys_write r4, numbuf, r5
    sys_close r4
    .done:
    pop r5
    pop r4
    ret


; Decimal digits at r1, at most r2 of them -> r0. Stops at the first non-digit,
; which is what makes the trailing newline (and a hand-edited file) harmless.
parse_uint:
    push r4                          ; cursor
    push r5                          ; remaining
    push r6                          ; value
    mov r4, r1
    mov r5, r2
    mov r6, 0
    .each:
        cmp r5, 0
        jile .done
        mov8 r0, [r4]
        cmp r0, 48
        jul .done
        cmp r0, 57
        jug .done
        sub r0, 48
        umul r6, 10
        add r6, r0
        add r4, 1
        sub r5, 1
        jmp .each
    .done:
    mov r0, r6
    pop r6
    pop r5
    pop r4
    ret


; ==========================
;   Randomness
; ==========================

; There is no entropy on this machine, so the clock is the seed. Two games started
; in the same millisecond would play the same, which is a price worth not caring
; about.
seed_rng:
    uptms
    or r0, 1
    mov [rngstate], r0
    ret


; A plain 32-bit LCG. r0 = a positive pseudo-random number.
rng:
    mov r0, [rngstate]
    umul r0, 1664525
    add r0, 1013904223
    mov [rngstate], r0
    shr r0, 16
    and r0, 0x7FFF
    ret


; Where the next hole should sit, vertically. r0 = a gap centre in units.
new_gap:
    call rng
    mov r1, GAP_SPAN
    udiv r0, r1                      ; r1 = remainder
    mov r0, r1
    add r0, GAP_MIN
    ret


; ==========================
;   Drawing
; ==========================

redraw:
    call clear_win                   ; the sky
    call draw_pipes
    call draw_ground
    call draw_bird
    call draw_hud
    mov r0, [state]
    cmp r0, ST_READY
    je .ready
    cmp r0, ST_DEAD
    je .over
    ret
    .ready:
    call draw_ready
    ret
    .over:
    call draw_over
    ret


draw_pipes:
    push r4                          ; index
    push r5                          ; x, in whole units
    push r6                          ; gap centre
    push r7                          ; a working edge
    mov r4, 0
    .each:
        cmp r4, NPIPES
        juge .done
        mov r0, r4
        umul r0, 4
        add r0, pipex
        mov r1, [r0]
        call u_of_fix
        mov r5, r0
        mov r0, r5                   ; entirely off one side? nothing to draw
        add r0, PIPE_W
        cmp r0, 0
        jile .next
        mov r0, [worldw]
        cmp r5, r0
        jige .next
        mov r0, r4
        umul r0, 4
        add r0, pipegap
        mov r6, [r0]

        mov r7, r6                   ; the upper pipe, hanging from the top
        sub r7, GAP_HALF
        mov [fc], PIPE_BODY
        mov [rux], r5
        mov [ruy], 0
        mov [ruw], PIPE_W
        mov [ruh], r7
        call rect_u
        mov [fc], PIPE_LIT           ; a highlight down its left side, so a pipe
        mov r0, r5                   ; reads as a tube rather than a slab
        add r0, 16
        mov [rux], r0
        mov [ruw], 22
        call rect_u
        mov [fc], PIPE_EDGE          ; and the lip on the end
        mov r0, r5
        sub r0, 10
        mov [rux], r0
        mov [ruw], PIPE_W + 20
        mov r0, r7
        sub r0, PIPE_CAP
        mov [ruy], r0
        mov [ruh], PIPE_CAP
        call rect_u

        mov r7, r6                   ; the lower pipe, standing on the ground
        add r7, GAP_HALF
        mov [fc], PIPE_BODY
        mov [rux], r5
        mov [ruy], r7
        mov [ruw], PIPE_W
        mov r0, GROUND_Y
        sub r0, r7
        mov [ruh], r0
        call rect_u
        mov [fc], PIPE_LIT
        mov r0, r5
        add r0, 16
        mov [rux], r0
        mov [ruw], 22
        call rect_u
        mov [fc], PIPE_EDGE
        mov r0, r5
        sub r0, 10
        mov [rux], r0
        mov [ruw], PIPE_W + 20
        mov [ruy], r7
        mov [ruh], PIPE_CAP
        call rect_u
        .next:
        add r4, 1
        jmp .each
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; The ground is drawn in pixels rather than units, because it runs to the right
; edge of the window and a rounded-down world width would leave a seam there.
draw_ground:
    push r4                          ; the top of the ground, in pixels
    mov r1, GROUND_Y
    call u2px
    mov r4, r0
    mov [fx], 0
    mov r0, [winw]
    mov [fw], r0
    mov [fy], r4
    mov r0, [winh]
    sub r0, r4
    mov [fh], r0
    mov [fc], GROUND_DIRT
    call fill_rect
    mov [fy], r4                     ; a band of grass along the top edge
    mov r1, GROUND_Y + 22
    call u2px
    sub r0, r4
    cmp r0, 1
    jige .gok
    mov r0, 1
    .gok:
    mov [fh], r0
    mov [fc], GROUND_GRASS
    call fill_rect
    mov r0, r4                       ; and a line under it
    mov r1, [fh]
    add r0, r1
    mov [fy], r0
    mov [fh], 1
    mov [fc], GROUND_LINE
    call fill_rect
    pop r4
    ret


draw_bird:
    push r4                          ; the bird's y, in whole units
    push r5                          ; its top edge
    mov r4, [yf]
    shr r4, 6
    mov r5, r4
    sub r5, BIRD_R

    mov [fc], BIRD_BODY
    mov r0, BIRD_X - BIRD_R
    mov [rux], r0
    mov [ruy], r5
    mov [ruw], BIRD_R + BIRD_R
    mov [ruh], BIRD_R + BIRD_R
    call rect_u

    mov [fc], BIRD_WING              ; a wing, low and to the back
    mov r0, BIRD_X - BIRD_R + 6
    mov [rux], r0
    mov r0, r4
    sub r0, 2
    mov [ruy], r0
    mov [ruw], 28
    mov [ruh], 18
    call rect_u

    mov [fc], EYE_WHITE
    mov r0, BIRD_X + 4
    mov [rux], r0
    mov r0, r5
    add r0, 12
    mov [ruy], r0
    mov [ruw], 18
    mov [ruh], 18
    call rect_u

    mov [fc], EYE_PUPIL
    mov r0, BIRD_X + 12
    mov [rux], r0
    mov r0, r5
    add r0, 16
    mov [ruy], r0
    mov [ruw], 8
    mov [ruh], 10
    call rect_u

    mov [fc], BIRD_BEAK
    mov r0, BIRD_X + BIRD_R - 4
    mov [rux], r0
    mov r0, r4
    add r0, 2
    mov [ruy], r0
    mov [ruw], 20
    mov [ruh], 13
    call rect_u
    pop r5
    pop r4
    ret


; The score while playing, and the best score always - a target is only a target
; if you can see it.
draw_hud:
    call pick_scales
    mov r0, [state]
    cmp r0, ST_PLAY
    jne .best
    mov r1, [score]
    mov r2, numbuf
    call utoa
    mov r0, [bigscale]
    mov [gscale], r0
    mov [gc], TEXT_COLOUR
    mov r1, 120
    call u2px
    mov r2, r0
    mov r1, numbuf
    call text_centre
    .best:
    mov r0, [smallscale]
    mov [gscale], r0
    mov [gc], TEXT_COLOUR
    mov r1, bestlbl
    mov r2, numbuf
    call strcpy_end
    mov r2, r0
    mov r1, [best]
    call utoa
    mov r1, 28
    call u2px
    mov [gy], r0
    mov r2, 6                        ; a small inset from the left edge
    mov r1, numbuf
    call draw_text_shadow
    ret


draw_ready:
    mov r0, [bigscale]
    mov [gscale], r0
    mov [gc], TEXT_COLOUR
    mov r1, 250
    call u2px
    mov r2, r0
    mov r1, title
    call text_centre
    mov r0, [smallscale]             ; below the bird, which sits in the middle
    mov [gscale], r0
    mov r1, 620
    call u2px
    mov r2, r0
    mov r1, howto
    call text_centre
    mov r1, 680
    call u2px
    mov r2, r0
    mov r1, quithint
    call text_centre
    ret


; The game-over panel. Laid out in pixels from the middle of the window outwards,
; so it fits whatever we have been granted - there is no size at which it is off
; the edge, only sizes at which it is cramped.
draw_over:
    push r4                          ; line height
    push r5                          ; the panel's top edge
    push r6                          ; its height
    call pick_scales
    mov r0, [smallscale]
    umul r0, GH
    add r0, 6
    mov r4, r0
    mov r0, [midscale]               ; title line + four text lines + padding
    umul r0, GH
    add r0, 10
    mov r6, r0
    mov r0, r4
    umul r0, 4
    add r6, r0
    add r6, 20
    mov r0, [winh]
    sub r0, r6
    mov r1, 2
    udiv r0, r1
    cmp r0, 0
    jige .yok
    mov r0, 0
    .yok:
    mov r5, r0

    mov r0, [winw]                   ; three quarters of the width, centred
    umul r0, 3
    mov r1, 4
    udiv r0, r1
    mov [fw], r0
    mov r1, [winw]
    sub r1, r0
    mov r0, r1
    mov r1, 2
    udiv r0, r1
    mov [fx], r0
    mov [fy], r5
    mov [fh], r6
    mov [fc], PANEL_EDGE
    call fill_rect
    mov r0, [fx]                     ; the border is the outer rectangle showing
    add r0, 2
    mov [fx], r0
    mov r0, [fw]
    sub r0, 4
    mov [fw], r0
    mov r0, r5
    add r0, 2
    mov [fy], r0
    mov r0, r6
    sub r0, 4
    mov [fh], r0
    mov [fc], PANEL_BG
    call fill_rect

    mov r0, r5
    add r0, 10
    mov [peny], r0
    mov r0, [midscale]
    mov [gscale], r0
    mov [gc], TEXT_COLOUR
    mov r1, overmsg
    mov r2, [peny]
    call text_centre
    mov r0, [midscale]
    umul r0, GH
    add r0, 10
    mov r1, [peny]
    add r0, r1
    mov [peny], r0

    mov r0, [smallscale]
    mov [gscale], r0
    mov r1, scorelbl                 ; SCORE n
    mov r2, numbuf
    call strcpy_end
    mov r2, r0
    mov r1, [score]
    call utoa
    mov r1, numbuf
    mov r2, [peny]
    call text_centre
    mov r0, [peny]
    add r0, r4
    mov [peny], r0

    mov r1, bestlbl                  ; BEST n
    mov r2, numbuf
    call strcpy_end
    mov r2, r0
    mov r1, [best]
    call utoa
    mov r1, numbuf
    mov r2, [peny]
    call text_centre
    mov r0, [peny]
    add r0, r4
    mov [peny], r0

    mov r0, [newbest]
    cmp r0, 0
    je .retry
    mov [gc], GOLD_COLOUR
    mov r1, newbestmsg
    mov r2, [peny]
    call text_centre
    mov [gc], TEXT_COLOUR
    .retry:
    mov r0, [peny]
    add r0, r4
    mov [peny], r0
    mov r1, retrymsg
    mov r2, [peny]
    call text_centre
    pop r6
    pop r5
    pop r4
    ret


; Text is sized from the window, not fixed, so a tile a quarter of the screen wide
; still reads. Everything is clipped anyway, so the clamps are about legibility.
pick_scales:
    mov r0, [winh]
    mov r1, 110
    udiv r0, r1
    cmp r0, 1
    jige .bok
    mov r0, 1
    .bok:
    cmp r0, 4
    jule .bset
    mov r0, 4
    .bset:
    mov [bigscale], r0
    mov r0, [winh]
    mov r1, 220
    udiv r0, r1
    cmp r0, 1
    jige .sok
    mov r0, 1
    .sok:
    cmp r0, 2
    jule .sset
    mov r0, 2
    .sset:
    mov [smallscale], r0
    add r0, 1
    mov [midscale], r0
    ret


; A rectangle given in world units. Both edges are converted rather than the origin
; plus a scaled width, so two rectangles that meet in the world still meet on
; screen instead of leaving a rounding seam between them.
rect_u:
    push r4                          ; left, in pixels
    push r5                          ; top, in pixels
    mov r1, [rux]
    call u2px
    mov r4, r0
    mov r1, [ruy]
    call u2px
    mov r5, r0
    mov r1, [rux]
    mov r0, [ruw]
    add r1, r0
    call u2px
    sub r0, r4
    mov [fw], r0
    mov r1, [ruy]
    mov r0, [ruh]
    add r1, r0
    call u2px
    sub r0, r5
    mov [fh], r0
    mov [fx], r4
    mov [fy], r5
    call fill_rect
    pop r5
    pop r4
    ret


; A string centred in the window, with a drop shadow. r1 = string, r2 = pen y.
; Uses gc and gscale.
text_centre:
    push r4                          ; string
    push r5                          ; pen y
    push r6                          ; pen x
    mov r4, r1
    mov r5, r2
    call strlen
    umul r0, GW
    mov r1, [gscale]
    umul r0, r1
    mov r1, [winw]
    sub r1, r0
    cmp r1, 0
    jige .ok
    mov r1, 0                        ; wider than the window: start at the edge
    .ok:
    mov r0, r1
    mov r1, 2
    udiv r0, r1
    mov r6, r0
    mov [gy], r5
    mov r1, r4
    mov r2, r6
    call draw_text_shadow
    pop r6
    pop r5
    pop r4
    ret


; The same string twice, one scaled pixel apart: white on a pale sky is otherwise
; unreadable, and a shadow costs less than a background panel behind every label.
; r1 = string, r2 = pen x, gy = pen y.
draw_text_shadow:
    push r4                          ; string
    push r5                          ; pen x
    push r6                          ; pen y
    push r7                          ; the caller's colour
    mov r4, r1
    mov r5, r2
    mov r6, [gy]
    mov r7, [gc]
    mov r0, [gscale]
    mov r1, r6
    add r1, r0
    mov [gy], r1
    mov [gc], TEXT_SHADOW
    mov r2, r5
    add r2, r0
    mov r1, r4
    call draw_text
    mov [gy], r6
    mov [gc], r7
    mov r1, r4
    mov r2, r5
    call draw_text
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Draw a null-terminated string. r1 = string, r2 = pen x. Uses gy, gc, gscale.
draw_text:
    push r4                          ; cursor
    push r5                          ; pen x
    push r6                          ; advance
    mov r4, r1
    mov r5, r2
    mov r6, [gscale]
    umul r6, GW
    .each:
        mov8 r0, [r4]
        cmp r0, 0
        je .done
        mov [gch], r0
        mov [gx], r5
        call draw_glyph
        add r5, r6
        add r4, 1
        jmp .each
    .done:
    pop r6
    pop r5
    pop r4
    ret


; One glyph, scaled by gscale. Inputs (globals): gx, gy, gch, gc, gscale.
draw_glyph:
    push r4                          ; glyph row
    push r5                          ; that row's font byte
    push r6                          ; bit index
    push r7                          ; scale
    mov r0, [gch]
    cmp r0, FONT_GLYPHS
    juge .done
    umul r0, GH
    add r0, font
    mov [gsrc], r0
    mov r7, [gscale]
    mov r4, 0
    .rows:
        cmp r4, GH
        juge .done
        mov r5, [gsrc]
        add r5, r4
        mov8 r5, [r5]
        cmp r5, 0
        je .nextrow                  ; blank row
        mov r6, 0
        .bits:
            cmp r6, GW
            juge .nextrow
            mov r0, 7                ; leftmost pixel is bit 7
            sub r0, r6
            mov r1, r5
            shr r1, r0
            and r1, 1
            cmp r1, 0
            je .nextbit
            mov r0, r6               ; one scale x scale block per set pixel
            umul r0, r7
            mov r1, [gx]
            add r0, r1
            mov [fx], r0
            mov r0, r4
            umul r0, r7
            mov r1, [gy]
            add r0, r1
            mov [fy], r0
            mov [fw], r7
            mov [fh], r7
            mov r0, [gc]
            mov [fc], r0
            call fill_rect
            .nextbit:
            add r6, 1
            jmp .bits
        .nextrow:
        add r4, 1
        jmp .rows
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Solid rectangle, clipped to the window on all four sides. Inputs (globals):
; fx, fy, fw, fh, fc. Clipping the *left* edge matters here in a way it does not
; in a program whose widgets are all inside their window: a pipe spends its last
; second half off the screen, and a negative x left unclipped would walk backwards
; through the framebuffer into the previous row.
fill_rect:
    push r4                          ; x
    push r5                          ; y
    push r6                          ; width
    push r7                          ; height
    mov r4, [fx]
    mov r5, [fy]
    mov r6, [fw]
    mov r7, [fh]
    cmp r6, 0
    jile .done
    cmp r7, 0
    jile .done
    cmp r4, 0                        ; clip left
    jige .lok
    add r6, r4
    mov r4, 0
    cmp r6, 0
    jile .done
    .lok:
    mov r0, [winw]
    cmp r4, r0
    jige .done
    mov r0, r4                       ; clip right
    add r0, r6
    mov r1, [winw]
    cmp r0, r1
    jile .rok
    mov r6, r1
    sub r6, r4
    .rok:
    cmp r5, 0                        ; clip top
    jige .tok
    add r7, r5
    mov r5, 0
    cmp r7, 0
    jile .done
    .tok:
    mov r0, [winh]
    cmp r5, r0
    jige .done
    mov r0, r5                       ; clip bottom
    add r0, r7
    mov r1, [winh]
    cmp r0, r1
    jile .bok
    mov r7, r1
    sub r7, r5
    .bok:
    .rows:
        cmp r7, 0
        jile .done
        mov r0, r5                   ; dst = winbuf + (y * winw + x) * 4
        mov r1, [winw]
        umul r0, r1
        add r0, r4
        umul r0, 4
        mov r1, [winbuf]
        add r0, r1
        mov r1, [fc]
        mov r2, r6
        .cols:
            mov [r0], r1
            add r0, 4
            sub r2, 1
            cmp r2, 0
            jne .cols
        add r5, 1
        sub r7, 1
        jmp .rows
    .done:
    pop r7
    pop r6
    pop r5
    pop r4
    ret


; Fill the whole window with the sky, by the doubling copy trick.
clear_win:
    push r4                          ; span filled
    push r5                          ; remaining
    push r6                          ; total bytes
    mov r6, [winw]
    mov r0, [winh]
    umul r6, r0
    umul r6, 4
    cmp r6, 0
    je .done
    mov r0, [winbuf]
    mov [r0], SKY
    mov r4, 4
    .fill:
        cmp r4, r6
        juge .done
        mov r5, r6
        sub r5, r4
        cmp r4, r5
        jule .use
        mov r0, [winbuf]
        add r0, r4
        mov r1, [winbuf]
        cpy r1, r5
        jmp .done
        .use:
        mov r0, [winbuf]
        add r0, r4
        mov r1, [winbuf]
        cpy r1, r4
        add r4, r4
        jmp .fill
    .done:
    pop r6
    pop r5
    pop r4
    ret


; ==========================
;   Strings
; ==========================

; strlen(r1) -> r0. r1 is left alone.
strlen:
    push r4
    mov r4, 0
    .l:
        mov r0, r1
        add r0, r4
        mov8 r0, [r0]
        cmp r0, 0
        je .done
        add r4, 1
        jmp .l
    .done:
    mov r0, r4
    pop r4
    ret


; strcpy(r1 = src, r2 = dst) -> r0 = the terminator's address, so a caller can go
; straight on appending - which is how "SCORE " and a number become one string.
strcpy_end:
    .l:
        mov8 r0, [r1]
        mov8 [r2], r0
        cmp r0, 0
        je .done
        add r1, 1
        add r2, 1
        jmp .l
    .done:
    mov r0, r2
    ret


; Unsigned decimal. r1 = value, r2 = destination -> r0 = the number of digits
; written (the terminator is written too, but not counted).
utoa:
    push r4                          ; the value being divided down
    push r5                          ; destination
    push r6                          ; digits produced
    mov r4, r1
    mov r5, r2
    mov r6, 0
    .digits:
        mov r0, r4
        mov r1, 10
        udiv r0, r1                  ; r0 = quotient, r1 = this digit
        add r1, 48
        mov r2, digbuf
        add r2, r6
        mov8 [r2], r1
        add r6, 1
        mov r4, r0
        cmp r4, 0
        jne .digits
    mov r0, 0                        ; they came out backwards
    .reverse:
        cmp r0, r6
        juge .done
        mov r1, r6
        sub r1, r0
        sub r1, 1
        add r1, digbuf
        mov8 r1, [r1]
        mov r2, r5
        add r2, r0
        mov8 [r2], r1
        add r0, 1
        jmp .reverse
    .done:
    mov r2, r5
    add r2, r6
    mov8 [r2], 0
    mov r0, r6
    pop r6
    pop r5
    pop r4
    ret


bestpath:
    dstr "/home/flappy.score\0"
title:
    dstr "FLAPPY\0"
howto:
    dstr "SPACE OR CLICK TO FLY\0"
quithint:
    dstr "ESC QUITS\0"
overmsg:
    dstr "GAME OVER\0"
scorelbl:
    dstr "SCORE \0"
bestlbl:
    dstr "BEST \0"
newbestmsg:
    dstr "NEW BEST!\0"
retrymsg:
    dstr "SPACE TO PLAY AGAIN\0"

font:
    dfile "../../build/font.bin"


; ---- state ----
winbuf:
    d32 0                            ; the sbrk'd pixel buffer
sid:
    d32 0
winw:
    d32 WANT_W                       ; the size we are currently drawing at
winh:
    d32 WANT_H
lastcfg:
    d32 0
worldw:
    d32 WORLD_H                      ; how many units wide the window is
dirty:
    d32 1                            ; force the first frame
state:
    d32 ST_READY
yf:
    d32 28800                        ; the bird's y, in 1/64 units
vel:
    d32 0                            ; and its velocity, in 1/64 units per tick
score:
    d32 0
best:
    d32 0
newbest:
    d32 0
lastms:
    d32 0                            ; uptms at the last simulated tick
deadms:
    d32 0
prevbtn:
    d32 0                            ; last frame's buttons, for press-edge detection
rngstate:
    d32 1
peny:
    d32 0                            ; the game-over panel's running pen
bigscale:
    d32 3                            ; glyph scales, chosen from the window height
midscale:
    d32 2
smallscale:
    d32 1
pipex:
    res8 NPIPES * 4                  ; x in 1/64 units, so it moves smoothly
pipegap:
    res8 NPIPES * 4                  ; the centre of its hole, in whole units
pipescored:
    res8 NPIPES * 4                  ; 1 once the bird is past it
cfgbuf:
    res8 12                          ; wconfig: width, height, config counter
inbuf:
    res8 12                          ; winput: x, y, buttons
numbuf:
    res8 32                          ; a formatted label, or the score file's text
digbuf:
    res8 16                          ; utoa's digits, before they are reversed
rux:
    d32 0                            ; the rectangle rect_u is about to draw
ruy:
    d32 0
ruw:
    d32 0
ruh:
    d32 0
fx:
    d32 0
fy:
    d32 0
fw:
    d32 0
fh:
    d32 0
fc:
    d32 0
gx:
    d32 0
gy:
    d32 0
gch:
    d32 0
gc:
    d32 0
gscale:
    d32 1
gsrc:
    d32 0
