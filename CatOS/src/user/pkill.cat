; pkill - signal processes chosen by name or by pid.
;
;   pkill <name>              send SIGTERM (15) to each process called <name>
;   pkill <pid>               send SIGTERM to just that one process
;   pkill -<signal> <target>  send that signal number instead, e.g. "pkill -9 spin"
;
; The target is a pid if it is all digits and a name otherwise, which is why a
; name is the last component of the program's path exactly as ps prints it and
; never a path - no argument can be read both ways. The name match is exact,
; there is no pattern matching here, so it is obvious what a given command will
; hit; a pid match is exact by construction and hits at most one process.
;
; Everything it needs is already userland-visible: pslist for the table, getpid
; to leave itself alone, kill to do the work. The kernel has no idea that killing
; by name is a thing, and killing by pid is only spelled differently here than in
; kill because it takes the same "did anything happen" reporting path.
;
; It reports each process it signals, because a signal is asynchronous - the
; target dies at some point after this exits, so without a line here you cannot
; tell "no such process" from "killed it, and it is still finishing up".
;
; Signalling is a request, not a guarantee: SIGTERM's default action terminates,
; but a process that installed a handler decides for itself, and the kernel
; refuses the signal outright for the idle process it needs to stay runnable.
#include "sys.cat"

#define DECBUF, 13                   ; 10 digits, spare, and the terminator

main:
    mov r5, r1                       ; argc (r5-r7 survive syscalls)
    mov r6, r2                       ; argv
    mov r0, SIGTERM                  ; the default, unless argv[1] overrides it
    mov [signum], r0
    cmp r5, 2
    jil .usage

    mov r1, r6                       ; argv[1]
    add r1, 4
    mov r1, [r1]
    mov8 r0, [r1]
    cmp r0, 45                       ; '-' -> a signal number, target follows it
    jne .havetarget
    add r1, 1
    call parsedec
    cmp r0, -1
    je .usage
    cmp r0, 1                        ; the kernel's valid range, so a typo is
    jil .badsig                      ; refused here rather than silently ignored
    cmp r0, NSIG_MAX
    jig .badsig
    mov [signum], r0
    cmp r5, 3
    jil .usage
    mov r1, r6                       ; argv[2] is then the target
    add r1, 8
    mov r1, [r1]
.havetarget:
    mov [target], r1                 ; kept whichever way it reads, since the
    call parsedec                    ; "not found" line echoes it back verbatim
    mov [targetpid], r0              ; -1 for anything that is not all digits,
                                     ; which is the flag for "match on the name"

    sys_getpid                       ; pkill is not its own target
    mov [selfpid], r0

    sys_pslist psbuf, PS_MAX
    cmp r0, -1
    je .listfail
    mov r5, r0                       ; live process count
    mov r6, psbuf                    ; record cursor
    mov r7, 0                        ; record index
    mov r0, 0
    mov [nmatched], r0               ; processes hit by the target, and of those
    mov [nkilled], r0                ; the ones the kernel took the signal for

    .scan:
        cmp r7, r5
        juge .report
        mov r0, [r6]                 ; PSREC_PID
        mov r1, [selfpid]
        cmp r0, r1
        je .next
        mov r1, r6
        add r1, PSREC_STATE
        mov r1, [r1]
        cmp r1, PS_ZOMBIE
        je .next                     ; already dead, just unreaped
        mov r1, [targetpid]
        cmp r1, -1
        je .byname
        mov r0, [r6]                 ; by pid: at most one record can match, but
        cmp r0, r1                   ; the scan runs on regardless - the table is
        jne .next                    ; 16 records, so an early exit buys nothing
        jmp .matched
        .byname:
        mov r1, r6
        add r1, PSREC_NAME
        mov r2, [target]
        call streq
        cmp r0, 1
        jne .next

        .matched:
        mov r1, [r6]                 ; signal it and say so
        mov [victim], r1
        mov r0, [nmatched]
        add r0, 1
        mov [nmatched], r0
        sys_kill r1, [signum]
        cmp r0, -1
        je .refused
        mov r0, [nkilled]
        add r0, 1
        mov [nkilled], r0
        sys_write 1, msg_sent, msg_sent_end - msg_sent
        jmp .said
        .refused:
        sys_write 1, msg_refused, msg_refused_end - msg_refused
        .said:
        mov r1, [victim]
        call putdec
        sys_write 1, newline, 1
        .next:
        add r6, PSREC_BYTES
        add r7, 1
        jmp .scan

    .report:                         ; "nothing matched" and "something did but the
    mov r0, [nmatched]               ; kernel said no" are different answers, and
    cmp r0, 0                        ; the second has already had its say per
    je .nomatch                      ; process
    mov r0, [nkilled]
    cmp r0, 0
    je .refusedall
    sys_exit 0

.refusedall:
    sys_exit 1

.nomatch:
    sys_write 1, msg_none, msg_none_end - msg_none
    mov r1, [target]
    call putstr
    sys_write 1, newline, 1
    sys_exit 1

.badsig:
    sys_write 1, msg_badsig, msg_badsig_end - msg_badsig
    sys_exit 1

.listfail:
    sys_write 1, msg_listfail, msg_listfail_end - msg_listfail
    sys_exit 1

.usage:
    sys_write 1, msg_usage, msg_usage_end - msg_usage
    sys_exit 1


; parsedec(r1) - the null-terminated decimal string at r1 as a value in r0, or -1
; if it is empty or holds anything but digits. Doubles as the "is this a pid or a
; name" test, so the -1 has to mean "not a number" and not "0" - it does, since a
; digit string never produces one. An absurdly long digit string wraps rather than
; erroring, which then simply matches no pid.
parsedec:
    push r4                          ; accumulator
    push r5                          ; digits seen
    mov r4, 0
    mov r5, 0
    .loop:
        mov8 r0, [r1]
        cmp r0, 0
        je .end
        cmp r0, 48                   ; '0'
        jul .bad
        cmp r0, 57                   ; '9'
        jug .bad
        sub r0, 48
        umul r4, 10
        add r4, r0
        add r5, 1
        add r1, 1
        jmp .loop
    .end:
    cmp r5, 0
    je .bad
    mov r0, r4
    jmp .done
    .bad:
    mov r0, -1
    .done:
    pop r5
    pop r4
    ret


; streq(r1, r2) -> r0 = 1 if the null-terminated strings match, else 0.
streq:
    push r4
    push r5
    mov r4, r1
    mov r5, r2
    .cmp:
        mov8 r0, [r4]
        mov8 r1, [r5]
        cmp r0, r1
        jne .no
        cmp r0, 0
        je .yes
        add r4, 1
        add r5, 1
        jmp .cmp
    .yes:
    mov r0, 1
    jmp .done
    .no:
    mov r0, 0
    .done:
    pop r5
    pop r4
    ret


; putstr(r1) - write a null-terminated string to stdout.
putstr:
    push r4                          ; length
    push r5                          ; string
    mov r5, r1
    mov r4, 0
    .len:
        mov8 r0, [r1]
        cmp r0, 0
        je .write
        add r4, 1
        add r1, 1
        jmp .len
    .write:
    sys_write 1, r5, r4
    pop r5
    pop r4
    ret


; putdec(r1) - write a value to stdout as decimal. Digits fall out
; least-significant-first, so they are generated backwards into numbuf.
putdec:
    push r4                          ; digit cursor
    push r5                          ; digit count
    mov r4, numbuf
    add r4, DECBUF
    mov r5, 0
    .digits:
        mov r2, 10
        udiv r1, r2                  ; r1 = quotient, r2 = remainder
        add r2, 48                   ; '0'
        sub r4, 1
        mov8 [r4], r2
        add r5, 1
        cmp r1, 0
        jne .digits
    mov r3, r4                       ; write(1, digits, count)
    mov r4, r5
    mov r2, 1
    mov r1, SYS_WRITE
    syscall
    pop r5
    pop r4
    ret


msg_usage:
    dstr "usage: pkill [-signal] <name|pid>\n"
msg_usage_end:
msg_badsig:
    dstr "pkill: signal out of range\n"
msg_badsig_end:
msg_listfail:
    dstr "pkill: cannot read the process table\n"
msg_listfail_end:
msg_sent:
    dstr "pkill: signalled pid "
msg_sent_end:
msg_refused:
    dstr "pkill: refused for pid "
msg_refused_end:
msg_none:
    dstr "pkill: no process matching "
msg_none_end:
newline:
    dstr "\n"

signum:
    res32 1
target:
    res32 1
targetpid:
    res32 1
selfpid:
    res32 1
victim:
    res32 1
nmatched:
    res32 1
nkilled:
    res32 1
numbuf:
    res8 DECBUF
psbuf:
    res8 PS_MAX * PSREC_BYTES
