; sh - a minimal interactive shell.
;
; Each iteration prints a prompt, reads a line from stdin (the console delivers a
; whole line on Enter), splits it into whitespace-separated tokens, and runs the
; first token as a program from /bin, passing the tokens as argv. It then waits
; for the child before prompting again. The built-in "exit" ends the shell.
;
; There is no current-working-directory concept in the kernel yet, so commands
; are always resolved as /bin/<name> and any path arguments are absolute.
#include "sys.cat"

#define MAXARGS, 8                   ; most tokens on one line (argv slots)
#define LINEBUF, 128                 ; longest input line
#define PATHBUF, 64                  ; "/bin/" + command name

main:
.prompt:
    sys_write 1, prompt, prompt_end - prompt
    sys_read 0, linebuf, LINEBUF - 1
    mov r5, r0                       ; bytes read (survives syscalls)
    cmp r5, 0
    jile .prompt                     ; nothing / error -> prompt again
    mov r0, linebuf                  ; null-terminate just past the last byte
    add r0, r5
    mov8 [r0], 0
    mov r0, linebuf                  ; the console includes a trailing newline;
    add r0, r5                       ; drop it so it isn't part of the last token
    sub r0, 1
    mov8 r1, [r0]
    cmp r1, 10
    jne .parse
    mov8 [r0], 0
.parse:

    mov r1, linebuf                  ; split into argv
    call tokenize
    cmp r0, 0
    je .prompt                       ; blank line

    mov r1, [argvec]                 ; built-in: exit
    mov r2, exitcmd
    call streq
    cmp r0, 1
    je .doexit

    call buildpath                   ; pathbuf = "/bin/" + argv[0]
    mov r3, argvec                   ; spawn it with the whole argv
    mov r2, pathbuf
    mov r1, SYS_SPAWN
    syscall
    cmp r0, -1
    je .notfound
    mov r2, r0                       ; wait for the child to finish
    mov r1, SYS_WAIT
    syscall
    jmp .prompt

.notfound:
    sys_write 1, nfmsg, nfmsg_end - nfmsg
    jmp .prompt

.doexit:
    sys_exit 0


; Split a null-terminated line at r1 into tokens, writing a pointer to each into
; argvec and null-terminating the array. Spaces between tokens are overwritten
; with 0 so each argv entry is its own C string. Returns r0 = argc.
tokenize:
    push r4                          ; cursor
    push r5                          ; argc
    push r6                          ; scratch
    mov r4, r1
    mov r5, 0
    .skip:                           ; skip leading spaces
        mov8 r0, [r4]
        cmp r0, 0
        je .fin
        cmp r0, 32
        jne .tok
        add r4, 1
        jmp .skip
    .tok:                            ; record the start of a token
        cmp r5, MAXARGS
        juge .fin
        mov r6, r5
        shl r6, 2
        add r6, argvec
        mov [r6], r4
        add r5, 1
    .scan:                           ; advance to the end of the token
        mov8 r0, [r4]
        cmp r0, 0
        je .fin
        cmp r0, 32
        jne .scannext
        mov8 [r4], 0                 ; terminate token, resume at the next char
        add r4, 1
        jmp .skip
    .scannext:
        add r4, 1
        jmp .scan
    .fin:
    mov r6, r5                       ; null-terminate the pointer array
    shl r6, 2
    add r6, argvec
    mov [r6], 0
    mov r0, r5
    pop r6
    pop r5
    pop r4
    ret


; Build pathbuf = "/bin/" followed by argv[0] and a null terminator.
buildpath:
    push r4                          ; write cursor
    push r5                          ; read cursor
    mov r4, pathbuf
    mov r5, binprefix
    .pre:
        mov8 r0, [r5]
        cmp r0, 0
        je .predone
        mov8 [r4], r0
        add r4, 1
        add r5, 1
        jmp .pre
    .predone:
    mov r5, [argvec]                 ; append the command name (incl. terminator)
    .name:
        mov8 r0, [r5]
        mov8 [r4], r0
        cmp r0, 0
        je .namedone
        add r4, 1
        add r5, 1
        jmp .name
    .namedone:
    pop r5
    pop r4
    ret


; streq(r1, r2) -> r0 = 1 if the null-terminated strings match, else 0.
streq:
    push r4
    push r5
    mov r4, r1
    mov r5, r2
    .cmp:
        mov8 r0, [r4]
        mov8 r3, [r5]
        cmp r0, r3
        jne .ne
        cmp r0, 0
        je .yes
        add r4, 1
        add r5, 1
        jmp .cmp
    .yes:
    mov r0, 1
    jmp .done
    .ne:
    mov r0, 0
    .done:
    pop r5
    pop r4
    ret


prompt:
    dstr "$ "
prompt_end:
nfmsg:
    dstr "sh: command not found\n"
nfmsg_end:
binprefix:
    dstr "/bin/\0"
exitcmd:
    dstr "exit\0"

argvec:
    res32 MAXARGS + 1
linebuf:
    res8 LINEBUF
pathbuf:
    res8 PATHBUF
